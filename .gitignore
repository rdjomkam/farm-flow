# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# backups
/backups

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Claude Code local settings — machine/user-specific, may contain local
# permission rules and locally-configured connection strings. Never track.
# (Sprint CI — voir docs/security/REMEDIATION-SECRET-HISTORIQUE.md)
.claude/settings.local.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
.env

# PWA build artifacts
public/sw.js
public/swe-worker-*.js
