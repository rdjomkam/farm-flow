model Site {
  id                       String                     @id @default(cuid())
  name                     String
  address                  String?
  isActive                 Boolean                    @default(true)
  supervised               Boolean                    @default(false)
  enabledModules           SiteModule[]               @default([])
  members                  SiteMember[]
  roles                    SiteRole[]
  bacs                     Bac[]
  vagues                   Vague[]
  releves                  Releve[]
  sessions                 Session[]
  fournisseurs             Fournisseur[]
  produits                 Produit[]
  mouvements               MouvementStock[]
  commandes                Commande[]
  releveConsommations      ReleveConsommation[]
  clients                  Client[]
  ventes                   Vente[]
  lignesVente              LigneVente[]               @relation("SiteLignesVente")
  factures                 Facture[]
  paiements                Paiement[]
  bonsLivraison            BonLivraison[]
  lignesBonLivraison       LigneBonLivraison[]
  reproducteurs            Reproducteur[]
  pontes                   Ponte[]
  lotsAlevins              LotAlevins[]
  configAlertes            ConfigAlerte[]
  notifications            Notification[]
  activites                Activite[]
  depenses                 Depense[]
  paiementsDepense         PaiementDepense[]
  fraisPaiementDepense     FraisPaiementDepense[]
  ajustementsDepense       AjustementDepense[]
  depensesRecurrentes      DepenseRecurrente[]
  listesBesoins            ListeBesoins[]
  lignesDepense            LigneDepense[]
  configsElevage           ConfigElevage[]
  // Sprint 20 — Packs & Provisioning
  packs                    Pack[]
  packActivationsVendeur   PackActivation[]           @relation("PackActivationsVendeur")
  packActivationsClient    PackActivation[]           @relation("PackActivationsClient")
  // Sprint 21 — Moteur d'activités
  reglesActivite           RegleActivite[]
  // Sprint 23 — Monitoring Ingénieur
  notesRecues              NoteIngenieur[]            @relation("NotesRecues")
  notes                    NoteIngenieur[]            @relation("NotesDKFarm")
  // Sprint 24 — Calibrage
  calibrages               Calibrage[]
  // AR.1 — Arrivages
  arrivages                Arrivage[]
  arrivageModifications    ArrivageModification[]
  // Sprint 26 — Modification tracking (ADR-014/ADR-015)
  releveModifications      ReleveModification[]
  calibrageModifications   CalibrageModification[]
  // Sprint FD — Feed Analytics
  historiqueNutritionnel   HistoriqueNutritionnel[]
  // Sprint Gompertz
  gompertzVagues           GompertzVague[]
  // Sprint 30 — Abonnements
  abonnements              Abonnement[]               @relation("AbonnementsSite")
  paiementsAbo             PaiementAbonnement[]       @relation("PaiementsAboSite")
  remises                  Remise[]                   @relation("RemisesSite")
  commissions              CommissionIngenieur[]      @relation("CommissionsDKFarm")
  commissionsClient        CommissionIngenieur[]      @relation("CommissionsSiteClient")
  portefeuilles            PortefeuilleIngenieur[]    @relation("PortefeuillesSite")
  retraits                 RetraitPortefeuille[]      @relation("RetraitsSite")
  // Sprint 30.4 — Idempotency
  idempotencyRecords       IdempotencyRecord[]
  // ADR-043 — Historique des assignations (Phase 2)
  assignationsBac          AssignationBac[]
  savedFilters             SavedFilter[]
  // Unités de production & transferts internes
  unitesProduction         UniteProduction[]
  transfertsInternes       TransfertInterne[]
  // PG.2 — Transferts pré-grossissement
  transferts               Transfert[]
  transfertModifications   TransfertModification[]
  // R1-S3 — Module Reproduction : lots géniteurs, incubations, traitements
  lotGeniteurs             LotGeniteurs[]
  incubations              Incubation[]
  traitementsIncubation    TraitementIncubation[]
  // ADR-020 — Subscription refactoring
  /**
   * /**
   * /**
   * Propriétaire du site — administrateur principal responsable de l'abonnement.
   */
  ownerId                  String
  owner                    User                       @relation("SiteOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  /**
   * Site bloqué (accès entièrement restreint, ex: impayé critique).
   */
  isBlocked                Boolean                    @default(false)
  // Sprint BL — Bon de livraison signé : assets promoteur pour le PDF
  /**
   * /**
   * Signature du promoteur du site — image PNG encodée en base64 (data URL),
   * apposée sur chaque bon de livraison généré.
   */
  signaturePromoteur       String?
  /**
   * Cachet/tampon du site — image PNG encodée en base64 (data URL).
   */
  cachet                   String?
  /**
   * Nom du promoteur affiché sous la signature dans le PDF du bon de livraison.
   */
  nomPromoteur             String?
  // ADR-021 — Cycle de vie & audit
  /**
   * /**
   * /**
   * /** Null si non suspendu. Non-null = site suspendu (accès restreint).
   */
  suspendedAt              DateTime?
  /**
   * Raison de la suspension — obligatoire lors de la suspension.
   */
  suspendedReason          String?
  /**
   * Soft delete — null = actif, non-null = archivé (lecture seule).
   */
  deletedAt                DateTime?
  auditLogs                SiteAuditLog[]
  // ADR-048 — Persistance des ecarts de conservation toleres (Sprint SU, story SU.2)
  ecartsAssignation        EcartAssignationConstate[]
  // Sprint PR1 — Prévisions
  scenariosPrevision       ScenarioPrevision[]
  paliersRemisePrevision   PalierRemise[]
  alimentsPrevision        AlimentPrevision[]
  repartitionsMoisAliment  RepartitionMoisAliment[]
  vaguesPrevues            VaguePrevue[]
  alimentsParVaguePrevue   AlimentParVaguePrevue[]
  postesPrevision          PostePrevision[]
  chargesMensuellesPrevues ChargeMensuellePrevue[]
  journalDepensesPrevues   JournalDepensePrevue[]
  apportsCapital           ApportCapital[]
  mappingsRapprochement    MappingRapprochement[]
  cloturesMois             ClotureMois[]
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@index([deletedAt])
  @@index([suspendedAt])
  @@index([ownerId])
}

// ──────────────────────────────────────────
// Modèles — ConfigElevage (Sprint 19)
// ──────────────────────────────────────────

/**
 * ConfigElevage — Parametres configurables par site pour piloter le moteur d'elevage.
 * Chaque site peut avoir plusieurs profils. Un seul peut etre isDefault=true par site.
 * Les valeurs par defaut correspondent aux benchmarks FAO pour Clarias gariepinus.
 */
model ConfigElevage {
  id          String  @id @default(cuid())
  /**
   * Nom du profil — ex: "Clarias Standard Cameroun"
   */
  nom         String
  description String?

  // ── Objectif de production ──────────────────────
  /**
   * /**
   * /**
   * /** Poids cible par poisson a la recolte (g) — ex: 800
   */
  poidsObjectif      Float
  /**
   * Duree estimee du cycle en jours — ex: 180
   */
  dureeEstimeeCycle  Int
  /**
   * Taux de survie cible en % — ex: 85
   */
  tauxSurvieObjectif Float

  // ── Phases de croissance (seuils de poids en g) ─
  /**
   * /**
   * /**
   * /** 0 → seuilAcclimatation g
   */
  seuilAcclimatation   Float @default(15)
  /**
   * seuilAcclimatation → seuilCroissanceDebut g
   */
  seuilCroissanceDebut Float @default(50)
  /**
   * seuilCroissanceDebut → seuilJuvenile g
   */
  seuilJuvenile        Float @default(150)
  /**
   * seuilJuvenile → seuilGrossissement g
   */
  seuilGrossissement   Float @default(350)
  /**
   * seuilGrossissement → seuilFinition g
   */
  seuilFinition        Float @default(700)
  // Au-dela de seuilFinition → PRE_RECOLTE

  // ── Alimentation : taille de granule par poids ──
  /**
   * /**
   * /**
   * /** JSON: [{poidsMin, poidsMax, tailleGranule, description, proteines}]
   */
  alimentTailleConfig Json
  /**
   * JSON: [{phase, tauxMin, tauxMax, frequence, notes}]
   */
  alimentTauxConfig   Json
  /**
   * JSON: [{phase, scoreMin, scoreMax, label, couleur}] — Feed Analytics (Sprint FA)
   */
  scoreAlimentConfig  Json?

  // ── Benchmarks : FCR (lower is better) ──────────
  fcrExcellentMax  Float @default(1.5)
  fcrBonMax        Float @default(1.8)
  fcrAcceptableMax Float @default(2.2)

  // ── Benchmarks : SGR (%/jour, higher is better) ─
  sgrExcellentMin  Float @default(2.0)
  sgrBonMin        Float @default(1.5)
  sgrAcceptableMin Float @default(1.0)

  // ── Benchmarks : Taux de survie (%) ─────────────
  survieExcellentMin  Float @default(90)
  survieBonMin        Float @default(85)
  survieAcceptableMin Float @default(80)

  // ── Benchmarks : Densite (kg/m3, lower is better)
  densiteExcellentMax  Float @default(7)
  densiteBonMax        Float @default(10)
  densiteAcceptableMax Float @default(15)

  // ── Benchmarks : Mortalite cumulative (%) ───────
  mortaliteExcellentMax  Float @default(3)
  mortaliteBonMax        Float @default(5)
  mortaliteAcceptableMax Float @default(10)

  // ── Qualite eau : seuils d'alerte ───────────────
  phMin        Float @default(6.5)
  phMax        Float @default(8.5)
  phOptimalMin Float @default(6.5)
  phOptimalMax Float @default(7.5)

  temperatureMin        Float @default(22)
  temperatureMax        Float @default(36)
  temperatureOptimalMin Float @default(26)
  temperatureOptimalMax Float @default(32)

  oxygeneMin     Float @default(1.5)
  oxygeneAlerte  Float @default(4.0)
  oxygeneOptimal Float @default(5.0)

  ammoniacMax     Float @default(0.5)
  ammoniacAlerte  Float @default(0.05)
  ammoniacOptimal Float @default(0.02)

  nitriteMax    Float @default(1.0)
  nitriteAlerte Float @default(0.5)

  // ── Mortalite : seuils d'alerte quotidiens ──────
  /**
   * /**
   * /**
   * /** % morts/jour → investigation
   */
  mortaliteQuotidienneAlerte   Float @default(1.0)
  /**
   * % morts/jour → urgence
   */
  mortaliteQuotidienneCritique Float @default(3.0)

  // ── Alimentation : seuils d'alerte ──────────────
  /**
   * /**
   * /**
   * /** FCR au-dela de ce seuil → reduire dose
   */
  fcrAlerteMax     Float @default(2.0)
  /**
   * Jours restants de stock → alerte
   */
  stockJoursAlerte Int   @default(5)

  // ── Tri / Grading ───────────────────────────────
  triPoidsMin        Float @default(5)
  triPoidsMax        Float @default(150)
  triIntervalleJours Int   @default(14)

  // ── Biometrie ───────────────────────────────────
  biometrieIntervalleDebut Int   @default(7)
  biometrieIntervalleFin   Int   @default(14)
  biometrieEchantillonPct  Float @default(10)

  // ── Changement d'eau ────────────────────────────
  eauChangementPct             Float @default(30)
  eauChangementIntervalleJours Int   @default(3)

  // ── Densite d'elevage ───────────────────────────
  densiteMaxPoissonsM3      Float @default(100)
  densiteOptimalePoissonsM3 Float @default(50)

  // ── Seuils de densité par type de système (kg/m3) — utilisés par le UI badge ─
  /**
   * /**
   * /**
   * /** Bac béton / plastique — seuil alerte orange
   */
  densiteBacBetonAlerte   Float @default(150)
  /**
   * Bac béton / plastique — seuil alerte rouge
   */
  densiteBacBetonCritique Float @default(200)
  /**
   * Étang en terre — seuil alerte orange
   */
  densiteEtangAlerte      Float @default(30)
  /**
   * Étang en terre — seuil alerte rouge
   */
  densiteEtangCritique    Float @default(40)
  /**
   * RAS — seuil alerte orange
   */
  densiteRasAlerte        Float @default(350)
  /**
   * RAS — seuil alerte rouge
   */
  densiteRasCritique      Float @default(500)

  // ── Renouvellement ───────────────────────────────
  /**
   * /**
   * /**
   * /** Fenêtre temporelle pour le calcul du taux de renouvellement effectif (jours)
   */
  fenetreRenouvellementJours Int @default(7)

  // ── Recolte ─────────────────────────────────────
  recoltePartiellePoidsSeuil Float @default(400)
  recolteJeuneAvantJours     Int   @default(2)

  // ── Cout de production ──────────────────────────
  /**
   * /**
   * Poids d'un sac d'aliment en kg pour ce profil (ex. 15 pour Skretting).
   * Prioritaire sur Produit.contenance dans le calcul du nombre de sacs
   * du cout de production. Null = fallback sur le produit.
   */
  poidsSacKg Float?

  // ── Calibrage Gompertz : parametres initiaux par defaut ─────────────────
  /**
   * /**
   * /**
   * /** Valeur initiale de W∞ (poids asymptotique en g) pour le calibrage Gompertz — ex: 1200
   */
  gompertzWInfDefault Float?
  /**
   * Valeur initiale de K (constante de croissance) pour le calibrage Gompertz — ex: 0.018
   */
  gompertzKDefault    Float?
  /**
   * Valeur initiale de tᵢ (point d'inflexion en jours) pour le calibrage Gompertz — ex: 95
   */
  gompertzTiDefault   Float?
  /**
   * Nombre minimum de biometries (dates uniques) pour declencher le calcul Gompertz
   */
  gompertzMinPoints   Int    @default(5)

  // ── Metadonnees ─────────────────────────────────
  /**
   * /**
   * /**
   * /** Profil par defaut du site (un seul isDefault=true par site)
   */
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  /**
   * ID du site (ferme) — R8
   */
  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  /**
   * Vagues utilisant ce profil
   */
  vagues Vague[]
  /**
   * Packs utilisant ce profil
   */
  packs  Pack[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([siteId, isDefault])
  @@index([siteId, isActive])
}

model SiteRole {
  id          String       @id @default(cuid())
  name        String
  description String?
  permissions Permission[]
  isSystem    Boolean      @default(false)
  siteId      String
  site        Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  members     SiteMember[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([siteId, name])
  @@index([siteId])
}

model SiteMember {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteRoleId String
  siteRole   SiteRole @relation(fields: [siteRoleId], references: [id], onDelete: Restrict)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, siteId])
  @@index([userId])
  @@index([siteId])
  @@index([siteRoleId])
}

// ──────────────────────────────────────────
// Modèles — Authentification
// ──────────────────────────────────────────

model User {
  id                     String                     @id @default(cuid())
  email                  String?                    @unique
  phone                  String?                    @unique
  name                   String
  passwordHash           String
  role                   Role                       @default(PISCICULTEUR)
  isActive               Boolean                    @default(true)
  sessions               Session[]
  memberships            SiteMember[]
  mouvements             MouvementStock[]
  commandes              Commande[]
  ventes                 Vente[]                    @relation("VenteUser")
  factures               Facture[]                  @relation("FactureUser")
  paiements              Paiement[]                 @relation("PaiementUser")
  bonsLivraison          BonLivraison[]
  configAlertes          ConfigAlerte[]
  notifications          Notification[]
  activitesCreees        Activite[]                 @relation("ActivitesCreees")
  activitesAssignees     Activite[]                 @relation("ActivitesAssignees")
  depenses               Depense[]
  paiementsDepense       PaiementDepense[]
  ajustementsDepense     AjustementDepense[]
  depensesRecurrentes    DepenseRecurrente[]
  listesBesoinsCreees    ListeBesoins[]             @relation("ListeBesoinsCreees")
  listesBesoinsValidees  ListeBesoins[]             @relation("ListeBesoinsValidees")
  // Sprint 20 — Packs & Provisioning
  packsCreated           Pack[]
  packActivationsCreees  PackActivation[]
  // Sprint 21 — Moteur d'activités
  reglesActivite         RegleActivite[]
  // Sprint 23 — Monitoring Ingénieur
  notesEnvoyees          NoteIngenieur[]            @relation("NotesEnvoyees")
  // Sprint 24 — Calibrage
  calibrages             Calibrage[]                @relation("CalibrageUser")
  releves                Releve[]                   @relation("ReleveUser")
  // AR.1 — Arrivages
  arrivages              Arrivage[]                 @relation("ArrivageUser")
  arrivageModifications  ArrivageModification[]     @relation("ArrivageModificationUser")
  // Sprint 26 — Modification tracking (ADR-014/ADR-015)
  releveModifications    ReleveModification[]
  calibrageModifications CalibrageModification[]
  isSystem               Boolean                    @default(false)
  // ADR-022 — Backoffice separation
  isSuperAdmin           Boolean                    @default(false)
  // Sprint — Impersonation
  originalSessions       Session[]                  @relation("OriginalUser")
  // Sprint 30 — Abonnements
  abonnementsUser        Abonnement[]               @relation("AbonnementsUser")
  paiementsAboInities    PaiementAbonnement[]       @relation("PaiementsAboUser")
  commissionsIngenieur   CommissionIngenieur[]      @relation("CommissionsIngenieur")
  remisesCreees          Remise[]                   @relation("RemisesUser")
  remisesApplications    RemiseApplication[]        @relation("RemisesApplicationsUser")
  portefeuille           PortefeuilleIngenieur?     @relation("PortefeuilleIngenieur")
  retraitsDemandes       RetraitPortefeuille[]      @relation("RetraitDemandeur")
  retraitsTraites        RetraitPortefeuille[]      @relation("RetraitTraiteur")
  // ADR-021 — Audit log des actions admin
  auditLogsActed         SiteAuditLog[]             @relation("AuditLogActor")
  // ADR-048 — Persistance des ecarts de conservation toleres (Sprint SU, story SU.2)
  ecartsAssignationActes EcartAssignationConstate[] @relation("EcartAssignationActor")
  // ADR-maintenance-mode — FeatureFlags modifies par ce super-admin
  featureFlags           FeatureFlag[]
  // ADR-maintenance-mode — PlatformAuditLog
  platformAuditLogs      PlatformAuditLog[]
  // ADR-020 — Subscription refactoring
  /**
   * /**
   * /**
   * Solde de crédit prépayé (FCFA) — utilisé pour les plans EXONERATION ou crédits offerts.
   */
  soldeCredit            Decimal                    @default(0)
  ownedSites             Site[]                     @relation("SiteOwner")
  essaisUtilises         EssaiUtilise[]             @relation("EssaisUtilises")
  auditsAbonnement       AbonnementAudit[]          @relation("AuditsAbonnement")
  savedFilters           SavedFilter[]              @relation("SavedFilters")
  transfertsInternes     TransfertInterne[]
  // PG.2 — Transferts pré-grossissement
  transferts             Transfert[]                @relation("TransfertUser")
  transfertModifications TransfertModification[]    @relation("TransfertModificationUser")
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  fraisPaiementDepenses  FraisPaiementDepense[]
  // Sprint PR1 — Prévisions
  scenariosPrevision     ScenarioPrevision[]
  cloturesMois           ClotureMois[]
}

model Session {
  id             String   @id @default(cuid())
  sessionToken   String   @unique
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeSiteId   String?
  activeSite     Site?    @relation(fields: [activeSiteId], references: [id])
  expires        DateTime
  createdAt      DateTime @default(now())
  locale         String   @default("fr")
  // Impersonation — non null uniquement lors d'une session d'impersonation
  originalUserId String?
  originalUser   User?    @relation("OriginalUser", fields: [originalUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([activeSiteId])
  @@index([originalUserId])
}

// ──────────────────────────────────────────
// Modèles — Élevage
// ──────────────────────────────────────────

model Bac {
  id                  String                     @id @default(cuid())
  nom                 String
  volume              Float?
  /**
   * Type de système d'élevage — détermine les seuils de densité applicables.
   * Null = BAC_BETON par défaut dans le moteur d'alertes.
   */
  typeSysteme         TypeSystemeBac?
  /**
   * Bac bloqué — ADR-020.
   */
  isBlocked           Boolean                    @default(false)
  siteId              String
  site                Site                       @relation(fields: [siteId], references: [id])
  releves             Releve[]
  lotsAlevins         LotAlevins[]
  activites           Activite[]
  calibrageGroupesDst CalibrageGroupe[]          @relation("GroupeDestBac")
  arrivagesGroupesDst ArrivageGroupe[]           @relation("ArrivageGroupeBac")
  lignesVente         LigneVente[]               @relation("BacLignesVente")
  // PG.2 — Transferts pré-grossissement
  transfertsBacSource TransfertGroupe[]          @relation("TransfertsBacSource")
  transfertsBacDest   TransfertGroupe[]          @relation("TransfertsBacDest")
  // ADR-043 Phase 3 — AssignationBac is the single source of truth for wave assignment & fish counts
  assignations        AssignationBac[]
  // R1-S3 — Lots géniteurs hébergés dans ce bac
  lotGeniteurs        LotGeniteurs[]
  // R1-S4 — Reproducteurs individuels hébergés dans ce bac
  reproducteurs       Reproducteur[]
  // ADR-048 — Persistance des ecarts de conservation toleres (Sprint SU, story SU.2)
  ecartsAssignation   EcartAssignationConstate[]
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([siteId])
}

model Vague {
  id                     String                     @id @default(cuid())
  code                   String                     @unique
  dateDebut              DateTime
  dateFin                DateTime?
  nombreInitial          Int
  poidsMoyenInitial      Float
  origineAlevins         String?
  statut                 StatutVague                @default(EN_COURS)
  /**
   * Type de vague : pré-grossissement ou grossissement standard
   */
  type                   TypeVague                  @default(GROSSISSEMENT)
  /**
   * Vague bloquée — ADR-020.
   */
  isBlocked              Boolean                    @default(false)
  poidsObjectifKg        Float?
  /**
   * Unité de production à laquelle cette vague est rattachée (REPRODUCTION ou GROSSISSEMENT)
   */
  uniteProductionId      String?
  uniteProduction        UniteProduction?           @relation(fields: [uniteProductionId], references: [id], onDelete: SetNull)
  siteId                 String
  site                   Site                       @relation(fields: [siteId], references: [id])
  /**
   * Config d'elevage associee (nullable — liee lors du provisioning Pack ou manuellement)
   */
  configElevageId        String?
  configElevage          ConfigElevage?             @relation(fields: [configElevageId], references: [id], onDelete: SetNull)
  /**
   * PackActivation source (nullable — renseigné si vague créée via provisioning)
   */
  packActivationId       String?
  packActivation         PackActivation?            @relation(fields: [packActivationId], references: [id], onDelete: SetNull)
  releves                Releve[]
  mouvements             MouvementStock[]
  ventes                 Vente[]
  lignesVente            LigneVente[]               @relation("VagueLignesVente")
  lotsAlevinsTransferes  LotAlevins[]
  activites              Activite[]
  depenses               Depense[]
  listesBesoinVagues     ListeBesoinsVague[]
  // Sprint 23 — Monitoring Ingénieur
  notes                  NoteIngenieur[]
  // Sprint 24 — Calibrage
  calibrages             Calibrage[]
  // AR.1 — Arrivages
  arrivages              Arrivage[]                 @relation("VagueArrivages")
  // Sprint FD — Feed Analytics
  historiqueNutritionnel HistoriqueNutritionnel[]
  // Sprint Gompertz
  gompertz               GompertzVague?
  // ADR-043 — Historique des assignations (Phase 2)
  assignations           AssignationBac[]
  // Transferts internes entrants depuis une unité de production
  transfertsEntrants     TransfertInterne[]         @relation("TransfertEntrant")
  // PG.2 — Transferts pré-grossissement
  transfertsSource       TransfertGroupe[]          @relation("TransfertsSource")
  transfertsDestination  TransfertGroupe[]          @relation("TransfertsDestination")
  // ADR-048 — Persistance des ecarts de conservation toleres (Sprint SU, story SU.2)
  ecartsAssignation      EcartAssignationConstate[]
  // Sprint PR1 — Prévisions (ADR-053 §3.7)
  vaguePrevueId          String?                    @unique
  vaguePrevue            VaguePrevue?               @relation(fields: [vaguePrevueId], references: [id], onDelete: SetNull)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@index([siteId])
  @@index([configElevageId])
  @@index([packActivationId])
  @@index([uniteProductionId])
}

/**
 * AssignationBac — table d'association Bac <-> Vague avec historique.
 * ADR-043 Phase 3 : source de vérité UNIQUE pour l'assignation d'un bac à une vague
 * et pour les compteurs de production (nombreActuel, nombreInitial, poidsMoyenInitial).
 * Les champs Bac.vagueId, Bac.nombrePoissons, Bac.nombreInitial, Bac.poidsMoyenInitial
 * ont été supprimés.
 * dateFin = null  : assignation active (bac actuellement dans la vague)
 * dateFin non-null: assignation terminée (bac retiré ou vague clôturée)
 * Contrainte d'unicité : un bac ne peut avoir qu'une seule assignation active
 * (dateFin IS NULL) à la fois. Cette contrainte est un index unique partiel SQL
 * ajouté manuellement dans la migration (non générée par Prisma).
 */
model AssignationBac {
  id                String    @id @default(cuid())
  bacId             String
  bac               Bac       @relation(fields: [bacId], references: [id], onDelete: Cascade)
  vagueId           String
  vague             Vague     @relation(fields: [vagueId], references: [id], onDelete: Cascade)
  siteId            String
  site              Site      @relation(fields: [siteId], references: [id])
  /**
   * Date de début de l'assignation (= date de création de la vague ou d'ajout du bac)
   */
  dateAssignation   DateTime  @default(now())
  /**
   * Date de fin de l'assignation — null = assignation active
   */
  dateFin           DateTime?
  /**
   * Nombre de poissons reçus à l'ouverture de cette assignation — immuable après création
   */
  nombreInitial     Int?      @map("nombrePoissonsInitial")
  /**
   * Poids moyen initial des poissons en grammes au démarrage de l'assignation
   */
  poidsMoyenInitial Float?
  /**
   * Nombre de poissons réellement présents maintenant (décrémenté par mortalité/vente, override par comptage)
   */
  nombreActuel      Int?      @map("nombrePoissons")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([bacId])
  @@index([vagueId])
  @@index([siteId])
  @@index([bacId, dateFin])
  @@index([vagueId, dateFin])
}

model Releve {
  id         String     @id @default(cuid())
  date       DateTime
  typeReleve TypeReleve
  // R3-S5 — vagueId nullable pour supporter les relevés de lots d'alevins (ADR-044 §5.2)
  vagueId    String?
  vague      Vague?     @relation(fields: [vagueId], references: [id])
  // R3-S5 — bacId nullable (optionnel pour les relevés de lots d'alevins sans bac assigné)
  bacId      String?
  bac        Bac?       @relation(fields: [bacId], references: [id])
  siteId     String
  site       Site       @relation(fields: [siteId], references: [id])
  userId     String?
  user       User?      @relation("ReleveUser", fields: [userId], references: [id])
  notes      String?

  // Champs biométrie
  poidsMoyen       Float?
  tailleMoyenne    Float?
  echantillonCount Int?

  // Champs mortalité
  nombreMorts    Int?
  causeMortalite CauseMortalite?

  // Champs vente (typeReleve = VENTE) — nombre de poissons vendus depuis ce bac
  nombreVendus Int?
  venteId      String?
  vente        Vente?  @relation("VenteReleves", fields: [venteId], references: [id], onDelete: SetNull)

  // Champs transfert (typeReleve = TRANSFERT) — nombre de poissons transférés
  // depuis ce bac vers une autre vague. Côté source uniquement.
  nombreTransferes  Int?
  transfertGroupeId String?
  transfertGroupe   TransfertGroupe? @relation("TransfertReleves", fields: [transfertGroupeId], references: [id], onDelete: SetNull)

  // Champs alimentation
  typeAliment      TypeAliment?
  quantiteAliment  Float?
  frequenceAliment Int?
  // Feed Analytics (Sprint FA)
  tauxRefus        Float? // valeurs : 0, 10, 25, 50
  comportementAlim ComportementAlimentaire?

  // Champs qualité eau
  temperature Float?
  ph          Float?
  oxygene     Float?
  ammoniac    Float?

  // Champs comptage
  nombreCompte    Int?
  methodeComptage MethodeComptage?
  // ADR-049 — écart constaté lors d'un COMPTAGE (nombreActuel_avant - nombreCompte)
  ecartConstate   Int?

  // ADR-049 — delta appliqué sur AssignationBac.nombreActuel (pour idempotence edit/delete)
  appliedDelta Int?

  // Champs observation
  description String?

  // Champs renouvellement eau — remplis uniquement quand typeReleve = RENOUVELLEMENT
  // L'un ou l'autre est renseigné (ou les deux si le formulaire calcule automatiquement)
  pourcentageRenouvellement Float? // % du volume du bac renouvelée (ex: 50 = 50%)
  volumeRenouvele           Float? // Volume réel en litres (alternative à pourcentageRenouvellement)
  nombreRenouvellements     Int?   @default(1) // Nombre de passages de renouvellement (ex: 25% × 4 = 100%)

  consommations ReleveConsommation[]
  mouvements    MouvementStock[]

  // Relation inverse : un releve peut etre lie a au plus une activite (1:1 optionnelle)
  activite Activite?

  // Lien vers le calibrage source (nullable — rempli si auto-cree lors d'un calibrage)
  calibrageId String?
  calibrage   Calibrage? @relation("CalibrageReleves", fields: [calibrageId], references: [id], onDelete: SetNull)

  // Lien vers l'arrivage source (nullable — rempli si auto-cree lors d'un arrivage)
  arrivageId String?
  arrivage   Arrivage? @relation("ArrivageReleves", fields: [arrivageId], references: [id], onDelete: SetNull)

  // Traçabilité modification (Sprint 26, ADR-014)
  modifie       Boolean              @default(false)
  modifications ReleveModification[]

  // R1-S4 — Lien optionnel vers un lot d'alevins (relevé de suivi alevinage)
  lotAlevinsId String?
  lotAlevins   LotAlevins? @relation(fields: [lotAlevinsId], references: [id])

  // Unité de production auto-résolue depuis le contexte (vague ou lot d'alevins)
  uniteProductionId String?
  uniteProduction   UniteProduction? @relation(fields: [uniteProductionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vagueId, typeReleve])
  @@index([bacId])
  @@index([date])
  @@index([calibrageId])
  @@index([arrivageId])
  @@index([siteId])
  @@index([lotAlevinsId])
  @@index([userId])
  @@index([venteId])
  @@index([uniteProductionId])
}

// ──────────────────────────────────────────
// Modèles — Stock & Approvisionnement
// ──────────────────────────────────────────

model Fournisseur {
  id        String     @id @default(cuid())
  nom       String
  telephone String?
  email     String?
  adresse   String?
  isActive  Boolean    @default(true)
  siteId    String
  site      Site       @relation(fields: [siteId], references: [id])
  produits  Produit[]
  commandes Commande[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([siteId])
}

model Produit {
  id                    String               @id @default(cuid())
  nom                   String
  categorie             CategorieProduit
  unite                 UniteStock
  uniteAchat            UniteStock?
  contenance            Float?
  prixUnitaire          Float
  stockActuel           Float                @default(0)
  seuilAlerte           Float                @default(0)
  fournisseurId         String?
  fournisseur           Fournisseur?         @relation(fields: [fournisseurId], references: [id], onDelete: SetNull)
  isActive              Boolean              @default(true)
  // Feed Analytics (Sprint FA) — caractéristiques nutritionnelles aliment
  tailleGranule         TailleGranule?
  formeAliment          FormeAliment?
  tauxProteines         Float?
  tauxLipides           Float?
  tauxFibres            Float?
  phasesCibles          PhaseElevage[]
  siteId                String
  site                  Site                 @relation(fields: [siteId], references: [id])
  mouvements            MouvementStock[]
  lignesCommande        LigneCommande[]
  consommations         ReleveConsommation[]
  lignesBesoins         LigneBesoin[]
  // ADR-027 — LigneDepense
  lignesDepense         LigneDepense[]
  // Sprint 20 — Packs & Provisioning
  packProduits          PackProduit[]
  // Sprint 21 — Moteur d'activités
  activitesRecommandees Activite[]           @relation("ActiviteProduitRecommande")
  // Sprint PR1 — Prévisions
  alimentsPrevision     AlimentPrevision[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([siteId])
  @@index([fournisseurId])
  @@index([categorie])
}

model MouvementStock {
  id             String        @id @default(cuid())
  produitId      String
  produit        Produit       @relation(fields: [produitId], references: [id])
  type           TypeMouvement
  quantite       Float
  prixTotal      Float?
  vagueId        String?
  vague          Vague?        @relation(fields: [vagueId], references: [id])
  commandeId     String?
  commande       Commande?     @relation(fields: [commandeId], references: [id])
  releveId       String?
  releve         Releve?       @relation(fields: [releveId], references: [id])
  depenseId      String?
  depense        Depense?      @relation(fields: [depenseId], references: [id], onDelete: SetNull)
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  date           DateTime
  notes          String?
  // Feed Analytics (Sprint FA) — traçabilité lot
  datePeremption DateTime?
  lotFabrication String?
  siteId         String
  site           Site          @relation(fields: [siteId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([siteId])
  @@index([produitId])
  @@index([date])
  @@index([vagueId])
  @@index([commandeId])
  @@index([releveId])
  @@index([depenseId])
}

model Commande {
  id             String           @id @default(cuid())
  numero         String
  fournisseurId  String
  fournisseur    Fournisseur      @relation(fields: [fournisseurId], references: [id])
  statut         StatutCommande   @default(BROUILLON)
  dateCommande   DateTime
  dateLivraison  DateTime?
  montantTotal   Float            @default(0)
  montantRecu    Float?
  /**
   * URL de la facture fournisseur stockee sur Hetzner Object Storage (nullable)
   */
  factureUrl     String?
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  siteId         String
  site           Site             @relation(fields: [siteId], references: [id])
  lignes         LigneCommande[]
  mouvements     MouvementStock[]
  depenses       Depense[]
  listeBesoinsId String?
  listeBesoins   ListeBesoins?    @relation(fields: [listeBesoinsId], references: [id], onDelete: SetNull)
  lignesBesoins  LigneBesoin[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([siteId, numero])
  @@index([siteId])
  @@index([fournisseurId])
  @@index([statut])
  @@index([dateCommande])
  @@index([listeBesoinsId])
}

model LigneCommande {
  id            String         @id @default(cuid())
  commandeId    String
  commande      Commande       @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  produitId     String
  produit       Produit        @relation(fields: [produitId], references: [id])
  quantite      Float
  prixUnitaire  Float
  quantiteRecue Float?
  /**
   * Lignes de dépense issues de cette ligne de commande (ADR-027)
   */
  lignesDepense LigneDepense[]
  createdAt     DateTime       @default(now())

  @@index([commandeId])
  @@index([produitId])
}

// ──────────────────────────────────────────
// Modèle — Consommation produits via relevés
// ──────────────────────────────────────────

model ReleveConsommation {
  id        String   @id @default(cuid())
  releveId  String
  releve    Releve   @relation(fields: [releveId], references: [id], onDelete: Cascade)
  produitId String
  produit   Produit  @relation(fields: [produitId], references: [id])
  quantite  Float
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id])
  createdAt DateTime @default(now())

  @@index([releveId])
  @@index([produitId])
  @@index([siteId])
}

// ──────────────────────────────────────────
// Modèles — Ventes & Facturation
// ──────────────────────────────────────────

model Client {
  id        String   @id @default(cuid())
  nom       String
  telephone String?
  email     String?
  adresse   String?
  isActive  Boolean  @default(true)
  isSysteme Boolean  @default(false)
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id])
  ventes    Vente[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

model Vente {
  id                String           @id @default(cuid())
  numero            String
  clientId          String
  client            Client           @relation(fields: [clientId], references: [id])
  vagueId           String?
  vague             Vague?           @relation(fields: [vagueId], references: [id])
  uniteProductionId String?
  uniteProduction   UniteProduction? @relation(fields: [uniteProductionId], references: [id])
  quantitePoissons  Int
  poidsTotalKg      Float
  prixUnitaireKg    Float
  montantTotal      Float
  dateCommande      DateTime         @default(now())
  statut            StatutVente      @default(EN_PREPARATION)
  /**
   * Origine des poissons vendus — Sprint VA. Determine si la vente provient
   * d'une vague de grossissement, d'un lot d'alevins (reproduction) ou d'une
   * vague PRE_GROSSISSEMENT vendue comme alevins.
   */
  origineType       OrigineVente     @default(GROSSISSEMENT)
  dateLivraison     DateTime?
  poidsCommandeKg   Float?
  quantiteCommandee Int?
  poidsLivreKg      Float?
  quantiteLivree    Int?
  notes             String?
  siteId            String
  site              Site             @relation(fields: [siteId], references: [id])
  userId            String
  user              User             @relation("VenteUser", fields: [userId], references: [id])
  facture           Facture?
  /**
   * Plusieurs BL par vente possibles (rectificatifs, Sprint BF phase 2) — le BL
   * actif est celui dont `rectifiePar` est null.
   */
  bonsLivraison     BonLivraison[]
  releves           Releve[]         @relation("VenteReleves")
  lignes            LigneVente[]     @relation("VenteLignes")
  depenses          Depense[]        @relation("VenteDepenses")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([siteId, numero])
  @@index([siteId])
  @@index([clientId])
  @@index([vagueId])
  @@index([uniteProductionId])
  @@index([statut])
}

model LigneVente {
  id                 String              @id @default(cuid())
  venteId            String
  vente              Vente               @relation("VenteLignes", fields: [venteId], references: [id], onDelete: Cascade)
  vagueId            String?
  vague              Vague?              @relation("VagueLignesVente", fields: [vagueId], references: [id])
  bacId              String?
  bac                Bac?                @relation("BacLignesVente", fields: [bacId], references: [id])
  lotAlevinsId       String?
  lotAlevins         LotAlevins?         @relation("LotAlevinsLignesVente", fields: [lotAlevinsId], references: [id])
  poidsTotalKg       Float
  poidsMoyenG        Float
  nombrePoissons     Int
  /**
   * Poids reellement livre pour cette ligne (Sprint AV). Nullable avant
   * livraison. Purement comptable — ne sert jamais a calculer des morts.
   */
  poidsLivreKg       Float?
  siteId             String
  site               Site                @relation("SiteLignesVente", fields: [siteId], references: [id])
  /**
   * Quantités saisies par BL pour cette ligne (Sprint BF) — un BL brouillon/en cours + éventuels rectificatifs futurs.
   */
  lignesBonLivraison LigneBonLivraison[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([venteId])
  @@index([vagueId])
  @@index([bacId])
  @@index([lotAlevinsId])
  @@index([siteId])
}

model Facture {
  id           String        @id @default(cuid())
  numero       String
  venteId      String        @unique
  vente        Vente         @relation(fields: [venteId], references: [id])
  statut       StatutFacture @default(BROUILLON)
  dateEmission DateTime      @default(now())
  dateEcheance DateTime?
  montantTotal Float
  montantPaye  Float         @default(0)
  notes        String?
  siteId       String
  site         Site          @relation(fields: [siteId], references: [id])
  userId       String
  user         User          @relation("FactureUser", fields: [userId], references: [id])
  paiements    Paiement[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([siteId, numero])
  @@index([siteId])
  @@index([statut])
}

/**
 * BonLivraison — Sprint BL. Bon de livraison signé sur place par le client et
 * le livreur au moment de la livraison. Obligatoire (statut SIGNE) pour passer
 * une vente de EN_PREPARATION à LIVREE.
 * Depuis Sprint BF phase 2 : une vente peut avoir plusieurs BL (rectificatifs),
 * voir `rectifieId`/`rectifiePar`. Le BL actif est celui dont `rectifiePar` est
 * null.
 */
model BonLivraison {
  id                  String              @id @default(cuid())
  numero              String
  /**
   * Plusieurs BL peuvent exister pour une meme vente (rectificatifs, Sprint BF
   * phase 2) — l'unicite a ete levee au profit d'un index simple. Un seul BL
   * est "actif" a la fois : celui pour lequel `rectifiePar` est null.
   */
  venteId             String
  vente               Vente               @relation(fields: [venteId], references: [id])
  statut              StatutBonLivraison  @default(BROUILLON)
  /**
   * BL rectifie par celui-ci (chaine A ← B ← C possible). L'original reste
   * SIGNE — le fait historique est immuable ; « annule » se deduit de la
   * presence de rectifiePar, sans statut supplementaire (Sprint BF phase 2).
   */
  rectifieId          String?             @unique
  rectifie            BonLivraison?       @relation("RectificationBL", fields: [rectifieId], references: [id])
  rectifiePar         BonLivraison?       @relation("RectificationBL")
  /**
   * Motif de la rectification (Sprint BF phase 2, Story BF.7a) — obligatoire
   * uniquement sur un rectificatif (rectifieId non null) ; null sur un BL
   * normal. Nullable au niveau schema (R7) car un BL normal n'en porte jamais.
   */
  motifRectification  String?
  /**
   * Date de livraison saisie à l'écran 1 du flux (Sprint BF), avant signature.
   */
  dateLivraison       DateTime?
  /**
   * Signature du client — image PNG encodée en base64 (data URL)
   */
  signatureClient     String?
  signataireClientNom String?
  /**
   * Signature du livreur — image PNG encodée en base64 (data URL)
   */
  signatureLivreur    String?
  signeLe             DateTime?
  /**
   * Utilisateur livreur ayant créé/signé le bon de livraison
   */
  userId              String
  user                User                @relation(fields: [userId], references: [id])
  siteId              String
  site                Site                @relation(fields: [siteId], references: [id])
  /**
   * Quantités livrées par ligne de vente (Sprint BF) — saisies avant signature,
   * snapshot du BL, base du rectificatif futur.
   */
  lignes              LigneBonLivraison[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([siteId, numero])
  @@index([siteId])
  @@index([userId])
  @@index([venteId])
}

// ──────────────────────────────────────────
// Modèle — Quantités livrées par ligne de BL (Sprint BF)
// ──────────────────────────────────────────

model LigneBonLivraison {
  id                   String       @id @default(cuid())
  bonLivraisonId       String
  bonLivraison         BonLivraison @relation(fields: [bonLivraisonId], references: [id], onDelete: Cascade)
  ligneVenteId         String
  ligneVente           LigneVente   @relation(fields: [ligneVenteId], references: [id])
  /**
   * Poids réellement livré (kg). Prérempli = poids commandé, ajustable avant signature.
   */
  poidsLivreKg         Float
  /**
   * Poissons morts pendant le transport (saisi explicitement — sprint AV, jamais déduit du poids).
   */
  nombreMortsTransport Int          @default(0)
  motifAvarie          String?
  /**
   * Nombre de poissons effectivement livrés pour cette ligne, figé au moment
   * de LA signature de CE bon (snapshot immuable — review Sprint BF phase 2).
   * Nullable : les lignes créées avant ce correctif n'ont pas cette valeur
   * (fallback sur LigneVente.nombrePoissons à la lecture PDF).
   */
  nombrePoissonsLivres Int?
  siteId               String
  site                 Site         @relation(fields: [siteId], references: [id])
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([bonLivraisonId, ligneVenteId])
  @@index([siteId])
  @@index([ligneVenteId])
}

model Paiement {
  id        String       @id @default(cuid())
  factureId String
  facture   Facture      @relation(fields: [factureId], references: [id], onDelete: Cascade)
  montant   Float
  mode      ModePaiement
  reference String?
  date      DateTime     @default(now())
  siteId    String
  site      Site         @relation(fields: [siteId], references: [id])
  userId    String
  user      User         @relation("PaiementUser", fields: [userId], references: [id])
  createdAt DateTime     @default(now())

  @@index([factureId])
  @@index([siteId])
}

// ──────────────────────────────────────────
// Modèles — Production Alevins
// ──────────────────────────────────────────

model Reproducteur {
  id                String              @id @default(cuid())
  code              String              @unique
  sexe              SexeReproducteur
  poids             Float
  age               Int?
  origine           String?
  statut            StatutReproducteur  @default(ACTIF)
  dateAcquisition   DateTime            @default(now())
  notes             String?
  // R1-S4 — Champs étendus
  modeGestion       ModeGestionGeniteur @default(INDIVIDUEL)
  photo             String?
  pitTag            String?
  nombrePontesTotal Int                 @default(0)
  dernierePonte     DateTime?
  tempsReposJours   Int?
  generation        GenerationGeniteur  @default(INCONNUE)
  sourcing          SourcingGeniteur    @default(ACHAT_FERMIER)
  bacId             String?
  bac               Bac?                @relation(fields: [bacId], references: [id])
  siteId            String
  site              Site                @relation(fields: [siteId], references: [id])
  pontesAsFemelle   Ponte[]             @relation("PonteFemelle")
  pontesAsMale      Ponte[]             @relation("PonteMale")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([siteId])
  @@index([siteId, statut])
  @@index([bacId])
}

model Ponte {
  id                   String                 @id @default(cuid())
  code                 String
  femelleId            String
  femelle              Reproducteur           @relation("PonteFemelle", fields: [femelleId], references: [id])
  maleId               String?
  male                 Reproducteur?          @relation("PonteMale", fields: [maleId], references: [id])
  datePonte            DateTime
  nombreOeufs          Int?
  tauxFecondation      Float?
  statut               StatutPonte            @default(EN_COURS)
  notes                String?
  // R1-S4 — Champs étendus
  typeHormone          TypeHormone?
  doseHormone          Float?
  doseMgKg             Float?
  coutHormone          Float?
  heureInjection       DateTime?
  temperatureEauC      Float?
  latenceTheorique     Int?
  heureStripping       DateTime?
  poidsOeufsPontesG    Float?
  nombreOeufsEstime    Int?
  qualiteOeufs         QualiteOeufs?
  methodeMale          MethodeExtractionMale?
  motiliteSperme       MotiliteSperme?
  tauxEclosion         Float?
  nombreLarvesViables  Int?
  coutTotal            Float?
  causeEchec           CauseEchecPonte?
  siteId               String
  site                 Site                   @relation(fields: [siteId], references: [id])
  lots                 LotAlevins[]
  /**
   * FK vers le groupe de femelles geniteurs (LotGeniteurs) — R1-S3
   */
  lotGeniteursFemellId String?
  lotGeniteursFemelle  LotGeniteurs?          @relation("PonteGroupeFemelle", fields: [lotGeniteursFemellId], references: [id])
  /**
   * FK vers le groupe de males geniteurs (LotGeniteurs) — R1-S3
   */
  lotGeniteursMaleId   String?
  lotGeniteursMale     LotGeniteurs?          @relation("PonteGroupeMale", fields: [lotGeniteursMaleId], references: [id])
  incubations          Incubation[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([siteId, code])
  @@index([siteId])
  @@index([femelleId])
  @@index([siteId, statut])
  @@index([lotGeniteursFemellId])
  @@index([lotGeniteursMaleId])
}

model LotAlevins {
  id                    String             @id @default(cuid())
  code                  String
  ponteId               String
  ponte                 Ponte              @relation(fields: [ponteId], references: [id])
  nombreInitial         Int
  nombreActuel          Int
  ageJours              Int                @default(0)
  poidsMoyen            Float?
  statut                StatutLotAlevins   @default(EN_INCUBATION)
  bacId                 String?
  bac                   Bac?               @relation(fields: [bacId], references: [id])
  vagueDestinationId    String?
  vagueDestination      Vague?             @relation(fields: [vagueDestinationId], references: [id])
  dateTransfert         DateTime?
  notes                 String?
  /**
   * FK vers l'incubation source — R1-S3
   */
  incubationId          String?
  incubation            Incubation?        @relation(fields: [incubationId], references: [id])
  // R1-S4 — Champs étendus
  phase                 PhaseLot           @default(INCUBATION)
  parentLotId           String?
  parentLot             LotAlevins?        @relation("LotSplits", fields: [parentLotId], references: [id])
  sousLots              LotAlevins[]       @relation("LotSplits")
  dateDebutPhase        DateTime           @default(now())
  nombreDeformesRetires Int                @default(0)
  poidsObjectifG        Float?
  destinationSortie     DestinationLot?
  releves               Releve[]
  transfertsInternes    TransfertInterne[]
  lignesVente           LigneVente[]       @relation("LotAlevinsLignesVente")
  siteId                String
  site                  Site               @relation(fields: [siteId], references: [id])
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([siteId, code])
  @@index([siteId])
  @@index([ponteId])
  @@index([siteId, statut])
  @@index([incubationId])
  @@index([parentLotId])
  @@index([siteId, phase])
}

// ──────────────────────────────────────────
// Modèles — Module Reproduction R1-S3
// ──────────────────────────────────────────

/**
 * LotGeniteurs — Groupe de geniteurs (males ou femelles) identifies comme unite de reproduction.
 * Remplace la gestion individuelle du modele Reproducteur pour les sites qui gerent
 * leurs geniteurs par lots. ADR-044 §3.2.
 */
model LotGeniteurs {
  id                          String             @id @default(cuid())
  code                        String
  nom                         String
  sexe                        SexeReproducteur
  nombrePoissons              Int
  poidsMoyenG                 Float?
  poidsMinG                   Float?
  poidsMaxG                   Float?
  origine                     String?
  sourcing                    SourcingGeniteur   @default(ACHAT_FERMIER)
  generation                  GenerationGeniteur @default(INCONNUE)
  dateAcquisition             DateTime           @default(now())
  nombreMalesDisponibles      Int?
  seuilAlerteMales            Int?
  dateRenouvellementGenetique DateTime?
  bacId                       String?
  bac                         Bac?               @relation(fields: [bacId], references: [id])
  statut                      StatutReproducteur @default(ACTIF)
  notes                       String?
  siteId                      String
  site                        Site               @relation(fields: [siteId], references: [id])
  pontesAsFemelle             Ponte[]            @relation("PonteGroupeFemelle")
  pontesAsMale                Ponte[]            @relation("PonteGroupeMale")
  createdAt                   DateTime           @default(now())
  updatedAt                   DateTime           @updatedAt

  @@unique([siteId, code])
  @@index([siteId])
  @@index([siteId, sexe])
  @@index([siteId, statut])
  @@index([bacId])
}

/**
 * Incubation — Suivi d'une phase d'incubation des oeufs issus d'une ponte.
 * Un enregistrement par cuvette/bac d'incubation. ADR-044 §3.4.
 */
model Incubation {
  id                  String                 @id @default(cuid())
  code                String
  ponteId             String
  ponte               Ponte                  @relation(fields: [ponteId], references: [id])
  substrat            SubstratIncubation     @default(RACINES_PISTIA)
  temperatureEauC     Float?
  dureeIncubationH    Int?
  dateDebutIncubation DateTime               @default(now())
  dateEclosionPrevue  DateTime?
  dateEclosionReelle  DateTime?
  nombreOeufsPlaces   Int?
  nombreLarvesEcloses Int?
  tauxEclosion        Float?
  nombreDeformes      Int?
  nombreLarvesViables Int?
  notesRetrait        String?
  statut              StatutIncubation       @default(EN_COURS)
  notes               String?
  siteId              String
  site                Site                   @relation(fields: [siteId], references: [id])
  traitements         TraitementIncubation[]
  lotAlevins          LotAlevins[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@unique([siteId, code])
  @@index([siteId])
  @@index([ponteId])
}

/**
 * TraitementIncubation — Traitement antifongique ou parasiticide applique pendant l'incubation.
 * Cascade delete avec Incubation parent. ADR-044 §3.5.
 */
model TraitementIncubation {
  id            String     @id @default(cuid())
  incubationId  String
  incubation    Incubation @relation(fields: [incubationId], references: [id], onDelete: Cascade)
  produit       String
  concentration String
  dureeMinutes  Int
  heure         DateTime   @default(now())
  notes         String?
  siteId        String
  site          Site       @relation(fields: [siteId], references: [id])
  createdAt     DateTime   @default(now())

  @@index([incubationId])
  @@index([siteId])
}

// ──────────────────────────────────────────
// Modèles — Alertes & Planning
// ──────────────────────────────────────────

model ConfigAlerte {
  id               String     @id @default(cuid())
  typeAlerte       TypeAlerte
  seuilValeur      Float?
  seuilPourcentage Float?
  enabled          Boolean    @default(true)
  userId           String
  user             User       @relation(fields: [userId], references: [id])
  siteId           String
  site             Site       @relation(fields: [siteId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([userId, siteId, typeAlerte])
  @@index([siteId])
}

model Notification {
  id            String         @id @default(cuid())
  typeAlerte    TypeAlerte
  titre         String
  message       String
  statut        StatutAlerte   @default(ACTIVE)
  lien          String?
  /**
   * Severite de l'alerte pour le tri visuel
   */
  severite      SeveriteAlerte @default(INFO)
  /**
   * Action directe recommandee (null si notification informative seulement)
   * Format : JSON { type: "CREER_RELEVE", typeReleve?, bacId?, vagueId? }
   * ou { type: "MODIFIER_BAC", bacId, champsAModifier? }
   * ou { type: "VOIR_VAGUE", vagueId }
   * ou { type: "VOIR_STOCK", produitId? }
   */
  actionPayload Json?
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  siteId        String
  site          Site           @relation(fields: [siteId], references: [id])
  createdAt     DateTime       @default(now())

  @@index([userId, siteId, statut])
  @@index([siteId])
  @@index([siteId, severite, statut])
}

model Activite {
  id                     String         @id @default(cuid())
  titre                  String
  description            String?
  typeActivite           TypeActivite
  statut                 StatutActivite @default(PLANIFIEE)
  dateDebut              DateTime
  dateFin                DateTime?
  recurrence             Recurrence?
  vagueId                String?
  vague                  Vague?         @relation(fields: [vagueId], references: [id])
  bacId                  String?
  bac                    Bac?           @relation(fields: [bacId], references: [id])
  assigneAId             String?
  assigneA               User?          @relation("ActivitesAssignees", fields: [assigneAId], references: [id])
  userId                 String
  user                   User           @relation("ActivitesCreees", fields: [userId], references: [id])
  siteId                 String
  site                   Site           @relation(fields: [siteId], references: [id])
  releveId               String?        @unique
  releve                 Releve?        @relation(fields: [releveId], references: [id])
  dateTerminee           DateTime?
  noteCompletion         String?
  // Sprint 21 — Moteur d'activités
  regleId                String?
  regle                  RegleActivite? @relation(fields: [regleId], references: [id], onDelete: SetNull)
  instructionsDetaillees String?
  conseilIA              String?
  produitRecommandeId    String?
  produitRecommande      Produit?       @relation("ActiviteProduitRecommande", fields: [produitRecommandeId], references: [id], onDelete: SetNull)
  quantiteRecommandee    Float?
  priorite               Int?
  isAutoGenerated        Boolean        @default(false)
  phaseElevage           PhaseElevage?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([siteId, dateDebut])
  @@index([siteId, statut])
  @@index([assigneAId])
  @@index([releveId])
  @@index([regleId])
  @@index([isAutoGenerated])
}

// ──────────────────────────────────────────
// Modèles — Moteur d'activités (Sprint 21)
// ──────────────────────────────────────────

/**
 * RegleActivite — Règle de déclenchement automatique d'activités planifiées.
 * siteId est nullable (F-15) : null = règle globale DKFarm applicable à tous les sites.
 * Un site peut surcharger une règle globale en créant sa propre règle avec le même
 * typeActivite + typeDeclencheur.
 */
model RegleActivite {
  id                              String           @id @default(cuid())
  nom                             String
  description                     String?
  typeActivite                    TypeActivite
  typeDeclencheur                 TypeDeclencheur
  /**
   * Seuil de déclenchement selon le type (ex: poids en g, % mortalité, FCR)
   */
  conditionValeur                 Float?
  /**
   * Seuil haut pour SEUIL_QUALITE (ex: pH max)
   */
  conditionValeur2                Float?
  /**
   * Phase d'élevage minimale (null = toutes phases)
   */
  phaseMin                        PhaseElevage?
  /**
   * Phase d'élevage maximale (null = borne haute non contrainte)
   */
  phaseMax                        PhaseElevage?
  /**
   * Intervalle en jours entre déclenchements (pour RECURRENT)
   */
  intervalleJours                 Int?
  /**
   * Template du titre de l'activité générée
   */
  titreTemplate                   String
  /**
   * Template de la description de l'activité générée
   */
  descriptionTemplate             String?
  /**
   * Template des instructions détaillées de l'activité générée
   */
  instructionsTemplate            String?
  /**
   * Priorité de l'activité générée (1=haute, 10=basse)
   */
  priorite                        Int              @default(5)
  isActive                        Boolean          @default(true)
  /**
   * EC-3.2 : one-shot pour les seuils — désactivé après premier déclenchement
   */
  firedOnce                       Boolean          @default(false)
  /**
   * Logique d'évaluation des conditions composées : ET = toutes, OU = au moins une.
   * N'a d'effet que si conditions.length > 0 (sinon evaluation legacy via typeDeclencheur).
   */
  logique                         LogiqueCondition @default(ET)
  /**
   * Action à effectuer quand la règle se déclenche (Sprint 29)
   */
  actionType                      ActionRegle      @default(ACTIVITE)
  /**
   * Sévérité de la notification (requis si actionType = NOTIFICATION ou LES_DEUX)
   */
  severite                        SeveriteAlerte?
  /**
   * Template du titre de la notification (requis si actionType = NOTIFICATION ou LES_DEUX)
   */
  titreNotificationTemplate       String?
  /**
   * Template de la description de la notification (optionnel)
   */
  descriptionNotificationTemplate String?
  /**
   * Type du CTA dans la notification : null = aucun bouton d'action
   */
  actionPayloadType               String?
  /**
   * F-15 : null = règle globale DKFarm, non null = règle propre au site
   */
  siteId                          String?
  site                            Site?            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  userId                          String?
  user                            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  activites                       Activite[]
  /**
   * Conditions composées (Sprint 27-28). Si vide, évaluation legacy via typeDeclencheur.
   */
  conditions                      ConditionRegle[]
  createdAt                       DateTime         @default(now())
  updatedAt                       DateTime         @updatedAt

  @@index([siteId])
  @@index([typeActivite])
  @@index([typeDeclencheur])
  @@index([isActive])
}

// ──────────────────────────────────────────
// Modèles — Densité & Conditions composées (Sprint 27-28)
// ──────────────────────────────────────────

/**
 * ConditionRegle — Condition élémentaire d'une règle à conditions composées.
 * Une RegleActivite peut avoir N ConditionRegle enfants.
 * Si conditions.length > 0, l'évaluation utilise la logique ET/OU définie sur la règle.
 * Si conditions.length == 0, l'évaluation legacy (typeDeclencheur + conditionValeur) s'applique.
 * Backward compatible : toutes les règles existantes ont 0 conditions.
 */
model ConditionRegle {
  id               String             @id @default(cuid())
  regleId          String
  regle            RegleActivite      @relation(fields: [regleId], references: [id], onDelete: Cascade)
  typeDeclencheur  TypeDeclencheur
  operateur        OperateurCondition @default(SUPERIEUR)
  /**
   * Seuil de déclenchement (ex: 50 pour 50 kg/m3, 3 pour 3 jours)
   */
  conditionValeur  Float?
  /**
   * Seuil haut — utilisé uniquement par l'opérateur ENTRE
   */
  conditionValeur2 Float?
  /**
   * Ordre d'évaluation dans la liste de conditions (0 = premier)
   */
  ordre            Int                @default(0)

  @@index([regleId])
}

// ──────────────────────────────────────────
// Modèles — Dépenses
// ──────────────────────────────────────────

model Depense {
  id                  String              @id @default(cuid())
  /**
   * Numéro auto-généré format DEP-YYYY-NNN
   */
  numero              String
  description         String
  categorieDepense    CategorieDepense
  montantTotal        Float
  montantPaye         Float               @default(0)
  /**
   * Cumul des frais supplémentaires de tous les paiements associés
   */
  montantFraisSupp    Float               @default(0)
  statut              StatutDepense       @default(NON_PAYEE)
  date                DateTime
  dateEcheance        DateTime?
  /**
   * URL facture fournisseur sur Hetzner Object Storage
   */
  factureUrl          String?
  notes               String?
  /**
   * Lien optionnel vers la commande d'origine
   */
  commandeId          String?
  commande            Commande?           @relation(fields: [commandeId], references: [id], onDelete: SetNull)
  /**
   * Lien optionnel vers la vague concernée
   */
  vagueId             String?
  vague               Vague?              @relation(fields: [vagueId], references: [id], onDelete: SetNull)
  /**
   * Lien optionnel vers la vente concernée (transport, packaging, frais de livraison...).
   * Mutuellement exclusif avec vagueId au niveau application (API DV.3).
   */
  venteId             String?
  vente               Vente?              @relation("VenteDepenses", fields: [venteId], references: [id], onDelete: SetNull)
  /**
   * Unité de production concernée (REPRODUCTION ou GROSSISSEMENT) — nullable
   */
  uniteProductionId   String?
  uniteProduction     UniteProduction?    @relation(fields: [uniteProductionId], references: [id], onDelete: SetNull)
  /**
   * Lien optionnel vers le template récurrent d'origine
   */
  depenseRecurrenteId String?
  depenseRecurrente   DepenseRecurrente?  @relation(fields: [depenseRecurrenteId], references: [id], onDelete: SetNull)
  /**
   * Lien optionnel vers la liste de besoins d'origine
   */
  listeBesoinsId      String?
  listeBesoins        ListeBesoins?       @relation(fields: [listeBesoinsId], references: [id], onDelete: SetNull)
  userId              String
  user                User                @relation(fields: [userId], references: [id])
  siteId              String
  site                Site                @relation(fields: [siteId], references: [id])
  paiements           PaiementDepense[]
  ajustements         AjustementDepense[]
  /**
   * Lignes de détail catégorielles (ADR-027) — optionnelles pour les dépenses manuelles
   */
  lignes              LigneDepense[]
  mouvements          MouvementStock[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([siteId, numero])
  @@index([siteId])
  @@index([siteId, categorieDepense])
  @@index([siteId, statut])
  @@index([commandeId])
  @@index([vagueId])
  @@index([venteId])
  @@index([uniteProductionId])
  @@index([listeBesoinsId])
  @@index([depenseRecurrenteId])
  @@index([date])
}

model PaiementDepense {
  id        String                 @id @default(cuid())
  depenseId String
  depense   Depense                @relation(fields: [depenseId], references: [id], onDelete: Cascade)
  montant   Float
  mode      ModePaiement
  reference String?
  date      DateTime               @default(now())
  userId    String
  user      User                   @relation(fields: [userId], references: [id])
  siteId    String
  site      Site                   @relation(fields: [siteId], references: [id])
  fraisSupp FraisPaiementDepense[]
  createdAt DateTime               @default(now())

  @@index([depenseId])
  @@index([siteId])
}

// ──────────────────────────────────────────
// Modèles — Frais supplémentaires sur paiements dépenses
// ──────────────────────────────────────────

model FraisPaiementDepense {
  id         String          @id @default(cuid())
  paiementId String
  paiement   PaiementDepense @relation(fields: [paiementId], references: [id], onDelete: Cascade)
  motif      MotifFraisSupp
  montant    Float
  notes      String?
  userId     String?
  user       User?           @relation(fields: [userId], references: [id])
  siteId     String
  site       Site            @relation(fields: [siteId], references: [id])
  /**
   * Soft-delete pour l'audit trail — null = actif, non-null = supprime
   */
  deletedAt  DateTime?
  createdAt  DateTime        @default(now())

  @@index([paiementId])
  @@index([siteId])
  @@index([deletedAt])
}

// ──────────────────────────────────────────
// Modèles — Ajustements de dépenses
// ──────────────────────────────────────────

model AjustementDepense {
  id             String                 @id @default(cuid())
  depenseId      String
  depense        Depense                @relation(fields: [depenseId], references: [id], onDelete: Cascade)
  montantAvant   Float
  montantApres   Float
  raison         String
  userId         String
  user           User                   @relation(fields: [userId], references: [id])
  siteId         String
  site           Site                   @relation(fields: [siteId], references: [id])
  /**
   * Type d'ajustement : MONTANT_TOTAL ou FRAIS_SUPP
   */
  typeAjustement TypeAjustementDepense  @default(MONTANT_TOTAL)
  /**
   * Paiement concerne pour un ajustement de type FRAIS_SUPP
   */
  paiementId     String?
  /**
   * Frais concerne (peut etre un ancien frais soft-deleted) pour FRAIS_SUPP
   */
  fraisId        String?
  /**
   * Action effectuee sur le frais : AJOUTE, MODIFIE, SUPPRIME
   */
  actionFrais    ActionAjustementFrais?
  createdAt      DateTime               @default(now())

  @@index([depenseId])
  @@index([siteId])
}

// ──────────────────────────────────────────
// Modèle — LigneDepense (ADR-027)
// ──────────────────────────────────────────

/**
 * LigneDepense — ligne de détail catégorielle d'une dépense.
 * Satellite analytique de Depense : permet la ventilation des coûts
 * par CategorieDepense au sein d'une même dépense.
 * Auto-populé par traiterBesoins() ; optionnel pour les dépenses manuelles.
 * montantTotal est calculé et persisté (quantite * prixUnitaire).
 */
model LigneDepense {
  id               String           @id @default(cuid())
  depenseId        String
  depense          Depense          @relation(fields: [depenseId], references: [id], onDelete: Cascade)
  /**
   * Désignation de l'article (repris de LigneBesoin.designation ou saisie manuelle)
   */
  designation      String
  /**
   * Catégorie de cette ligne — sous-ensemble de CategorieDepense
   */
  categorieDepense CategorieDepense
  quantite         Float
  prixUnitaire     Float
  /**
   * quantite * prixUnitaire — calculé et persisté à la création/mise à jour
   */
  montantTotal     Float
  /**
   * Produit en stock d'origine (nullable)
   */
  produitId        String?
  produit          Produit?         @relation(fields: [produitId], references: [id], onDelete: SetNull)
  /**
   * Ligne de besoin d'origine (nullable)
   */
  ligneBesoinId    String?
  ligneBesoin      LigneBesoin?     @relation(fields: [ligneBesoinId], references: [id], onDelete: SetNull)
  /**
   * Ligne de commande d'origine (nullable)
   */
  ligneCommandeId  String?
  ligneCommande    LigneCommande?   @relation(fields: [ligneCommandeId], references: [id], onDelete: SetNull)
  /**
   * R8 — siteId obligatoire, identique au siteId de la Depense parente
   */
  siteId           String
  site             Site             @relation(fields: [siteId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([depenseId])
  @@index([siteId])
  @@index([siteId, categorieDepense])
  @@index([produitId])
  @@index([ligneBesoinId])
  @@index([ligneCommandeId])
}

// ──────────────────────────────────────────
// Modèles — Dépenses Récurrentes (Sprint 18)
// ──────────────────────────────────────────

model DepenseRecurrente {
  id                 String              @id @default(cuid())
  description        String
  categorieDepense   CategorieDepense
  montantEstime      Float
  frequence          FrequenceRecurrence
  /**
   * Jour du mois de génération (1-28, contraint par CHECK côté SQL)
   */
  jourDuMois         Int                 @default(1)
  isActive           Boolean             @default(true)
  derniereGeneration DateTime?
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  siteId             String
  site               Site                @relation(fields: [siteId], references: [id])
  /**
   * Unité de production concernée (REPRODUCTION ou GROSSISSEMENT) — nullable
   */
  uniteProductionId  String?
  uniteProduction    UniteProduction?    @relation(fields: [uniteProductionId], references: [id], onDelete: SetNull)
  depenses           Depense[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([siteId])
  @@index([siteId, isActive])
  @@index([siteId, frequence])
  @@index([uniteProductionId])
}

// ──────────────────────────────────────────
// Modèles — Besoins (Sprint 17)
// ──────────────────────────────────────────

model ListeBesoins {
  id                String              @id @default(cuid())
  /**
   * Numéro auto-généré format BES-YYYY-NNN
   */
  numero            String
  titre             String
  demandeurId       String
  demandeur         User                @relation("ListeBesoinsCreees", fields: [demandeurId], references: [id])
  valideurId        String?
  valideur          User?               @relation("ListeBesoinsValidees", fields: [valideurId], references: [id])
  statut            StatutBesoins       @default(SOUMISE)
  /**
   * Somme estimée des besoins (SUM quantite * prixEstime)
   */
  montantEstime     Float               @default(0)
  /**
   * Montant réel après clôture (nullable)
   */
  montantReel       Float?
  /**
   * Motif de rejet (nullable, rempli si REJETEE)
   */
  motifRejet        String?
  notes             String?
  /**
   * Date limite de traitement (optionnelle — R7 nullabilite explicite)
   */
  dateLimite        DateTime?
  siteId            String
  site              Site                @relation(fields: [siteId], references: [id])
  lignes            LigneBesoin[]
  depenses          Depense[]
  commandes         Commande[]
  /**
   * Vagues associées avec leurs ratios de répartition (remplace vagueId direct)
   */
  vagues            ListeBesoinsVague[]
  /**
   * Unité de production rattachée (GROSSISSEMENT ou REPRODUCTION).
   * Nullable pour rétrocompatibilité avec les listes existantes.
   */
  uniteProductionId String?
  uniteProduction   UniteProduction?    @relation(fields: [uniteProductionId], references: [id], onDelete: SetNull)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([siteId, numero])
  @@index([siteId])
  @@index([siteId, statut])
  @@index([demandeurId])
  @@index([dateLimite])
  @@index([uniteProductionId])
}

/**
 * Table de jonction entre ListeBesoins et Vague avec ratio de répartition des coûts
 */
model ListeBesoinsVague {
  id             String       @id @default(cuid())
  listeBesoinsId String
  listeBesoins   ListeBesoins @relation(fields: [listeBesoinsId], references: [id], onDelete: Cascade)
  vagueId        String
  vague          Vague        @relation(fields: [vagueId], references: [id], onDelete: Cascade)
  /// Fraction du coût imputée à cette vague. Doit être > 0 et <= 1.
  /// La somme des ratio pour un même listeBesoinsId doit être = 1.0
  ratio          Float        @default(1.0)
  /**
   * ID du site (ferme) — R8
   */
  siteId         String
  createdAt      DateTime     @default(now())

  @@unique([listeBesoinsId, vagueId])
  @@index([vagueId])
  @@index([siteId])
}

model LigneBesoin {
  id             String         @id @default(cuid())
  listeBesoinsId String
  listeBesoins   ListeBesoins   @relation(fields: [listeBesoinsId], references: [id], onDelete: Cascade)
  /**
   * Désignation libre de l'article
   */
  designation    String
  /**
   * Produit en stock lié (nullable — libre si null)
   */
  produitId      String?
  produit        Produit?       @relation(fields: [produitId], references: [id], onDelete: SetNull)
  quantite       Float
  /**
   * Unité libre (nullable si produit avec unité définie)
   */
  unite          UniteBesoin?
  /**
   * Prix unitaire estimé
   */
  prixEstime     Float          @default(0)
  /**
   * Prix unitaire réel après clôture (nullable)
   */
  prixReel       Float?
  /**
   * Commande générée lors du traitement (nullable)
   */
  commandeId     String?
  commande       Commande?      @relation(fields: [commandeId], references: [id], onDelete: SetNull)
  /**
   * Lignes de dépense issues de cette ligne de besoin (ADR-027)
   */
  lignesDepense  LigneDepense[]
  createdAt      DateTime       @default(now())

  @@index([listeBesoinsId])
  @@index([produitId])
  @@index([commandeId])
}

// ──────────────────────────────────────────
// Modèles — Phase 3 : Packs & Provisioning (Sprint 20)
// ──────────────────────────────────────────

/**
 * Pack — Kit de démarrage vendu aux clients pisciculteurs.
 * Un Pack regroupe une ConfigElevage + une liste de Produits (aliments, intrants)
 * et configure la vague initiale (nombre d'alevins, poids initial).
 * Basé sur la section 3.2 du REQ-STARTER-PACKS.md.
 */
model Pack {
  id                String         @id @default(cuid())
  /**
   * Nom commercial du pack — ex: "Starter 300"
   */
  nom               String
  description       String?
  /**
   * Nombre d'alevins fournis (> 0)
   */
  nombreAlevins     Int
  /**
   * Poids moyen initial des alevins (g)
   */
  poidsMoyenInitial Float          @default(5)
  /**
   * Prix total du pack en FCFA (>= 0)
   */
  prixTotal         Float          @default(0)
  /**
   * ConfigElevage recommandée pour ce pack
   */
  configElevageId   String?
  configElevage     ConfigElevage? @relation(fields: [configElevageId], references: [id], onDelete: SetNull)
  isActive          Boolean        @default(true)
  /**
   * Créateur du pack (ADMIN DKFarm)
   */
  userId            String
  user              User           @relation(fields: [userId], references: [id])
  /**
   * Site DKFarm propriétaire du pack — R8
   */
  siteId            String
  site              Site           @relation(fields: [siteId], references: [id])

  /**
   * Plan d'abonnement associé à ce pack
   */
  planId String
  plan   PlanAbonnement @relation(fields: [planId], references: [id])

  produits    PackProduit[]
  bacs        PackBac[]
  activations PackActivation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([configElevageId])
  @@index([userId])
  @@index([planId])
}

/**
 * PackProduit — Ligne de produit incluse dans un Pack.
 * Un même Produit ne peut figurer qu'une fois par Pack (contrainte unique).
 * onDelete: Restrict sur Produit pour éviter les suppressions orphelines (EC-1.6).
 */
model PackProduit {
  id        String      @id @default(cuid())
  packId    String
  pack      Pack        @relation(fields: [packId], references: [id], onDelete: Cascade)
  produitId String
  produit   Produit     @relation(fields: [produitId], references: [id], onDelete: Restrict)
  /**
   * Quantité incluse dans le pack (> 0)
   */
  quantite  Float
  /**
   * Unité choisie (NULL = unité par défaut du produit)
   */
  unite     UniteStock?

  @@unique([packId, produitId])
  @@index([packId])
  @@index([produitId])
}

/**
 * PackBac — Bac modele inclus dans un Pack.
 * Decrit le nombre et la configuration des bacs fournis dans le pack.
 * Un meme nom de bac ne peut figurer qu'une fois par Pack.
 */
model PackBac {
  id                String @id @default(cuid())
  packId            String
  pack              Pack   @relation(fields: [packId], references: [id], onDelete: Cascade)
  nom               String
  volume            Float?
  nombreAlevins     Int
  poidsMoyenInitial Float  @default(5)
  position          Int    @default(0)

  @@unique([packId, nom])
  @@index([packId])
}

/**
 * PackActivation — Enregistrement d'une vente de pack à un client.
 * Créée lors du provisioning transactionnel.
 * - siteId = site DKFarm vendeur (R8)
 * - clientSiteId = site créé pour le client
 * IMPORTANT : Pas de @unique sur clientSiteId (un client peut acheter plusieurs packs — F-05)
 * IMPORTANT : Pas de @unique sur vagueId (une vague peut être splitée après tri — F-06)
 */
model PackActivation {
  id             String           @id @default(cuid())
  /**
   * Code d'activation généré ACT-YYYY-NNN
   */
  code           String           @unique
  packId         String
  pack           Pack             @relation(fields: [packId], references: [id], onDelete: Restrict)
  /**
   * Utilisateur ayant activé le pack (ingénieur ou admin DKFarm)
   */
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  /**
   * Site DKFarm vendeur — R8
   */
  siteId         String
  site           Site             @relation("PackActivationsVendeur", fields: [siteId], references: [id])
  /**
   * Site client créé lors du provisioning
   */
  clientSiteId   String
  clientSite     Site             @relation("PackActivationsClient", fields: [clientSiteId], references: [id])
  statut         StatutActivation @default(ACTIVE)
  dateActivation DateTime         @default(now())
  dateExpiration DateTime?
  notes          String?

  /**
   * Vagues créées lors du provisioning pour cette activation
   */
  vagues Vague[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([clientSiteId])
  @@index([packId])
  @@index([userId])
  @@index([code])
  @@index([statut])
}

// ──────────────────────────────────────────
// Modèles — Monitoring Ingénieur (Sprint 23)
// ──────────────────────────────────────────

/**
 * NoteIngenieur — note ou observation envoyee par un ingenieur DKFarm vers un site client.
 * Deux usages :
 * 1. Note de suivi (isFromClient=false) : l'ingenieur redige une note technique (PUBLIC ou INTERNE).
 * 2. Observation client (isFromClient=true) : le client remonte une observation via observationTexte.
 * Deux relations vers Site :
 * - siteId : site DKFarm de l'ingenieur (R8 — chaque modele a un siteId)
 * - clientSiteId : site client destinataire de la note
 */
model NoteIngenieur {
  id               String         @id @default(cuid())
  /**
   * Titre court de la note
   */
  titre            String
  /**
   * Contenu en Markdown
   */
  contenu          String
  /**
   * Visibilite : PUBLIC (visible client) ou INTERNE (DKFarm uniquement)
   */
  visibility       VisibiliteNote
  /**
   * Marquer la note comme urgente
   */
  isUrgent         Boolean        @default(false)
  /**
   * Marquer la note comme lue par le destinataire
   */
  isRead           Boolean        @default(false)
  /**
   * True si cette note est une observation soumise par le client
   */
  isFromClient     Boolean        @default(false)
  /**
   * Texte libre de l'observation client (nullable, utilise si isFromClient=true)
   */
  observationTexte String?

  /**
   * Ingenieur auteur de la note
   */
  ingenieurId String
  ingenieur   User   @relation("NotesEnvoyees", fields: [ingenieurId], references: [id])

  /**
   * Site client destinataire
   */
  clientSiteId String
  clientSite   Site   @relation("NotesRecues", fields: [clientSiteId], references: [id])

  /**
   * Vague concernee (nullable)
   */
  vagueId String?
  vague   Vague?  @relation(fields: [vagueId], references: [id], onDelete: SetNull)

  /**
   * Site DKFarm de l'ingenieur — R8
   */
  siteId String
  site   Site   @relation("NotesDKFarm", fields: [siteId], references: [id])

  /**
   * Reponse a une note parente (thread one-level deep)
   */
  replyToId String?
  replyTo   NoteIngenieur?  @relation("NoteReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   NoteIngenieur[] @relation("NoteReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([clientSiteId])
  @@index([ingenieurId])
  @@index([vagueId])
  @@index([visibility])
  @@index([isFromClient])
  @@index([isRead])
  @@index([clientSiteId, isRead])
  @@index([clientSiteId, visibility])
  @@index([replyToId])
}

// ──────────────────────────────────────────
// Modèles — Calibrage (Sprint 24)
// ──────────────────────────────────────────

model Calibrage {
  id           String            @id @default(cuid())
  date         DateTime
  vagueId      String
  vague        Vague             @relation(fields: [vagueId], references: [id])
  sourceBacIds String[]
  nombreMorts  Int               @default(0)
  notes        String?
  siteId       String
  site         Site              @relation(fields: [siteId], references: [id])
  userId       String
  user         User              @relation("CalibrageUser", fields: [userId], references: [id])
  groupes      CalibrageGroupe[]

  // Traçabilité modification (Sprint 26, ADR-015)
  modifie       Boolean                 @default(false)
  modifications CalibrageModification[]

  // Relevés auto-créés lors du calibrage
  releves Releve[] @relation("CalibrageReleves")

  // Snapshots — état vague+bacs avant création / avant modification (Fix 5)
  snapshotAvant      Json?
  snapshotAvantModif Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vagueId])
  @@index([siteId])
}

model CalibrageGroupe {
  id               String             @id @default(cuid())
  calibrageId      String
  calibrage        Calibrage          @relation(fields: [calibrageId], references: [id], onDelete: Cascade)
  categorie        CategorieCalibrage
  destinationBacId String
  destinationBac   Bac                @relation("GroupeDestBac", fields: [destinationBacId], references: [id])
  nombrePoissons   Int
  poidsMoyen       Float
  tailleMoyenne    Float?
  createdAt        DateTime           @default(now())

  @@index([calibrageId])
}

// ──────────────────────────────────────────
// Modèles — Traçabilité modification (Sprint 26, ADR-014/ADR-015)
// ──────────────────────────────────────────

/**
 * ReleveModification — trace d'une modification de relevé avec raison d'audit.
 * Une ligne par champ modifié.
 * Cascade DELETE avec Releve (si un relevé est supprimé, ses traces le sont aussi).
 */
model ReleveModification {
  id             String   @id @default(cuid())
  releveId       String
  releve         Releve   @relation(fields: [releveId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  raison         String
  champModifie   String
  ancienneValeur String?
  nouvelleValeur String?
  siteId         String
  site           Site     @relation(fields: [siteId], references: [id])
  createdAt      DateTime @default(now())

  @@index([releveId])
  @@index([userId])
  @@index([siteId])
}

/**
 * CalibrageModification — trace d'une modification de calibrage avec raison d'audit.
 * Une ligne par champ modifié (nombreMorts, notes, groupes).
 * Pour "groupes" : ancienneValeur/nouvelleValeur contiennent du JSON sérialisé.
 * Cascade DELETE avec Calibrage.
 */
model CalibrageModification {
  id             String    @id @default(cuid())
  calibrageId    String
  calibrage      Calibrage @relation(fields: [calibrageId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  raison         String
  champModifie   String
  ancienneValeur String?
  nouvelleValeur String?
  siteId         String
  site           Site      @relation(fields: [siteId], references: [id])
  createdAt      DateTime  @default(now())

  @@index([calibrageId])
  @@index([userId])
  @@index([siteId])
}

// ──────────────────────────────────────────
// Enums — CustomPlaceholder (Sprint 26)
// ──────────────────────────────────────────

enum PlaceholderMode {
  MAPPING
  FORMULA
}

enum PlaceholderFormat {
  NUMBER
  TEXT
}

// ──────────────────────────────────────────
// Enums — Abonnements & Paiements (Sprint 30)
// ──────────────────────────────────────────

enum TypePlan {
  DECOUVERTE
  ELEVEUR
  PROFESSIONNEL
  ENTREPRISE
  INGENIEUR_STARTER
  INGENIEUR_PRO
  INGENIEUR_EXPERT
  EXONERATION
}

enum PeriodeFacturation {
  MENSUEL
  TRIMESTRIEL
  ANNUEL
}

enum StatutAbonnement {
  ACTIF
  EN_GRACE
  SUSPENDU
  EXPIRE
  ANNULE
  EN_ATTENTE_PAIEMENT
}

enum StatutPaiementAbo {
  EN_ATTENTE
  INITIE
  CONFIRME
  ECHEC
  REMBOURSE
  EXPIRE
}

enum TypeRemise {
  EARLY_ADOPTER
  SAISONNIERE
  PARRAINAGE
  COOPERATIVE
  VOLUME
  MANUELLE
}

enum StatutCommissionIng {
  EN_ATTENTE
  DISPONIBLE
  DEMANDEE
  PAYEE
  ANNULEE
}

enum FournisseurPaiement {
  SMOBILPAY
  MTN_MOMO
  ORANGE_MONEY
  MANUEL
}

// ──────────────────────────────────────────
// Modèle — CustomPlaceholder (Sprint 26)
// ──────────────────────────────────────────

/**
 * CustomPlaceholder — variable personnalisee utilisable dans les templates de regles d'activites.
 * Deux modes :
 * - MAPPING : le placeholder pointe vers un champ de la base via sourcePath
 * - FORMULA : le placeholder est calcule via une formule mathematique (formula)
 * Ces placeholders sont globaux (pas de siteId) — geres par DKFarm.
 */
model CustomPlaceholder {
  id          String  @id @default(cuid())
  /**
   * Cle unique du placeholder — ex: "poids_moyen", "fcr_actuel"
   */
  key         String  @unique
  /**
   * Libelle affiche dans l'editeur de regles
   */
  label       String
  /**
   * Description de l'usage du placeholder (nullable)
   */
  description String?
  /**
   * Exemple de valeur affichee dans l'interface
   */
  example     String

  /**
   * Mode de resolution : MAPPING (champ DB) ou FORMULA (calcul)
   */
  mode       PlaceholderMode
  /**
   * Chemin vers le champ source (mode MAPPING) — ex: "vague.poidsMoyen"
   */
  sourcePath String?
  /**
   * Expression de calcul (mode FORMULA) — ex: "alimentation / biomasse"
   */
  formula    String?

  /**
   * Format de la valeur resolue
   */
  format   PlaceholderFormat @default(NUMBER)
  /**
   * Nombre de decimales pour le format NUMBER
   */
  decimals Int               @default(2)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────
// Modèle — PlanAbonnement (Sprint 30)
// ──────────────────────────────────────────

/**
 * PlanAbonnement — Définition immuable d'un palier tarifaire.
 * Global (non lié à un site spécifique) — pas de siteId (exception documentée R8).
 * Prix null = plan gratuit ou période non disponible.
 */
model PlanAbonnement {
  id               String       @id @default(cuid())
  nom              String
  typePlan         TypePlan     @unique
  description      String?
  prixMensuel      Decimal?
  prixTrimestriel  Decimal?
  prixAnnuel       Decimal?
  limitesSites     Int          @default(1)
  limitesBacs      Int          @default(3)
  limitesVagues    Int          @default(1)
  limitesIngFermes Int?
  isActif          Boolean      @default(true)
  isPublic         Boolean      @default(true)
  /**
   * Modules fonctionnels inclus dans ce plan — COMMISSIONS/REMISES exclus (platform-only)
   */
  modulesInclus    SiteModule[] @default([])
  /**
   * Durée de l'essai gratuit en jours (null = pas d'essai pour ce plan).
   */
  dureeEssaiJours  Int?

  abonnements          Abonnement[]
  downgradeAbonnements Abonnement[] @relation("DowngradeVers")
  remises              Remise[]
  packs                Pack[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([typePlan])
}

// ──────────────────────────────────────────
// Modèle — Abonnement (Sprint 30)
// ──────────────────────────────────────────

/**
 * Abonnement — Instance d'un abonnement lié à un utilisateur.
 * Sprint 52 : siteId rendu nullable — l'abonnement est au niveau user, pas site.
 * R7 : dateFinGrace nullable (absent pour plan gratuit).
 */
model Abonnement {
  id                         String              @id @default(cuid())
  siteId                     String?
  site                       Site?               @relation("AbonnementsSite", fields: [siteId], references: [id])
  planId                     String
  plan                       PlanAbonnement      @relation(fields: [planId], references: [id])
  periode                    PeriodeFacturation
  statut                     StatutAbonnement    @default(EN_ATTENTE_PAIEMENT)
  dateDebut                  DateTime
  dateFin                    DateTime
  dateProchainRenouvellement DateTime
  dateFinGrace               DateTime?
  prixPaye                   Decimal
  userId                     String
  user                       User                @relation("AbonnementsUser", fields: [userId], references: [id])
  remiseId                   String?
  remise                     Remise?             @relation(fields: [remiseId], references: [id])
  // ADR-020 — Subscription refactoring fields
  /**
   * /**
   * /**
   * Motif de l'exonération (obligatoire si typePlan = EXONERATION).
   */
  motifExoneration           String?
  /**
   * Vrai si cet abonnement est un essai gratuit.
   */
  isEssai                    Boolean             @default(false)
  /**
   * Durée de l'essai en jours (null si pas un essai).
   */
  dureeEssaiJours            Int?
  /**
   * Plan de downgrade programmé (null si aucun downgrade en attente).
   */
  downgradeVersId            String?
  downgradeVers              PlanAbonnement?     @relation("DowngradeVers", fields: [downgradeVersId], references: [id])
  /**
   * Période de facturation du downgrade.
   */
  downgradePeriode           PeriodeFacturation?
  /**
   * Ressources à garder lors du downgrade (JSON : bacs, vagues, membres conservés).
   */
  downgradeRessourcesAGarder Json?
  /**
   * Prochaine période de facturation choisie (changement en fin de cycle).
   */
  prochainePeriode           PeriodeFacturation?

  paiements         PaiementAbonnement[]
  remisesAppliquees RemiseApplication[]
  commissions       CommissionIngenieur[]
  audits            AbonnementAudit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([statut])
  @@index([planId])
  @@index([dateFin])
  @@index([downgradeVersId])
}

// ──────────────────────────────────────────
// Modèle — PaiementAbonnement (Sprint 30)
// ──────────────────────────────────────────

/**
 * PaiementAbonnement — Transaction de paiement pour un abonnement.
 * Idempotence : referenceExterne (unique côté gateway).
 * Sprint 52 : siteId rendu nullable — le paiement est lié à l'abonnement user-level.
 */
model PaiementAbonnement {
  id               String              @id @default(cuid())
  abonnementId     String
  abonnement       Abonnement          @relation(fields: [abonnementId], references: [id])
  montant          Decimal
  fournisseur      FournisseurPaiement
  statut           StatutPaiementAbo   @default(EN_ATTENTE)
  referenceExterne String?
  phoneNumber      String?
  metadata         Json?
  initiePar        String
  user             User                @relation("PaiementsAboUser", fields: [initiePar], references: [id])
  dateInitiation   DateTime
  dateConfirmation DateTime?
  siteId           String?
  site             Site?               @relation("PaiementsAboSite", fields: [siteId], references: [id])

  commissions CommissionIngenieur[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([abonnementId])
  @@index([siteId])
  @@index([statut])
  @@index([referenceExterne])
}

// ──────────────────────────────────────────
// Modèle — Remise (Sprint 30)
// ──────────────────────────────────────────

/**
 * Remise — Définition d'une remise ou code promotionnel.
 * R8 : siteId nullable car remise peut être globale (DKFarm).
 * R7 : dateFin nullable pour remises sans expiration.
 */
model Remise {
  id                 String          @id @default(cuid())
  nom                String
  code               String          @unique
  type               TypeRemise
  valeur             Decimal
  estPourcentage     Boolean         @default(false)
  dateDebut          DateTime
  dateFin            DateTime?
  limiteUtilisations Int?
  nombreUtilisations Int             @default(0)
  isActif            Boolean         @default(true)
  siteId             String?
  site               Site?           @relation("RemisesSite", fields: [siteId], references: [id])
  userId             String
  user               User            @relation("RemisesUser", fields: [userId], references: [id])
  planId             String?
  plan               PlanAbonnement? @relation(fields: [planId], references: [id])

  abonnements  Abonnement[]
  applications RemiseApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([code])
}

// ──────────────────────────────────────────
// Modèle — RemiseApplication (Sprint 30)
// ──────────────────────────────────────────

/**
 * RemiseApplication — Enregistrement d'une remise appliquée à un abonnement.
 * Contrainte unique : une remise ne peut être appliquée qu'une fois par abonnement.
 */
model RemiseApplication {
  id            String     @id @default(cuid())
  remiseId      String
  remise        Remise     @relation(fields: [remiseId], references: [id])
  abonnementId  String
  abonnement    Abonnement @relation(fields: [abonnementId], references: [id])
  montantReduit Decimal
  appliqueLe    DateTime   @default(now())
  userId        String
  user          User       @relation("RemisesApplicationsUser", fields: [userId], references: [id])

  @@unique([remiseId, abonnementId])
  @@index([remiseId])
  @@index([abonnementId])
}

// ──────────────────────────────────────────
// Modèle — CommissionIngenieur (Sprint 30)
// ──────────────────────────────────────────

/**
 * CommissionIngenieur — Commission calculée pour un ingénieur
 * suite à la confirmation d'un paiement d'abonnement d'un site supervisé.
 * R8 : siteId obligatoire.
 */
model CommissionIngenieur {
  id                   String              @id @default(cuid())
  ingenieurId          String
  ingenieur            User                @relation("CommissionsIngenieur", fields: [ingenieurId], references: [id])
  siteClientId         String
  siteClient           Site                @relation("CommissionsSiteClient", fields: [siteClientId], references: [id])
  abonnementId         String
  abonnement           Abonnement          @relation(fields: [abonnementId], references: [id])
  paiementAbonnementId String
  paiementAbonnement   PaiementAbonnement  @relation(fields: [paiementAbonnementId], references: [id])
  montant              Decimal
  taux                 Decimal
  statut               StatutCommissionIng @default(EN_ATTENTE)
  periodeDebut         DateTime
  periodeFin           DateTime
  siteId               String
  site                 Site                @relation("CommissionsDKFarm", fields: [siteId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ingenieurId])
  @@index([abonnementId])
  @@index([siteId])
  @@index([statut])
}

// ──────────────────────────────────────────
// Modèle — PortefeuilleIngenieur (Sprint 30)
// ──────────────────────────────────────────

/**
 * PortefeuilleIngenieur — Portefeuille financier de l'ingénieur.
 * Un ingénieur a exactement un portefeuille (@@unique sur ingenieurId).
 * R8 : siteId obligatoire (site DKFarm gestionnaire).
 */
model PortefeuilleIngenieur {
  id           String  @id @default(cuid())
  ingenieurId  String  @unique
  ingenieur    User    @relation("PortefeuilleIngenieur", fields: [ingenieurId], references: [id])
  solde        Decimal @default(0)
  soldePending Decimal @default(0)
  totalGagne   Decimal @default(0)
  totalPaye    Decimal @default(0)
  siteId       String
  site         Site    @relation("PortefeuillesSite", fields: [siteId], references: [id])

  retraits RetraitPortefeuille[]

  updatedAt DateTime @updatedAt

  @@index([siteId])
}

// ──────────────────────────────────────────
// Modèle — RetraitPortefeuille (Sprint 30)
// ──────────────────────────────────────────

/**
 * RetraitPortefeuille — Demande de virement du portefeuille ingénieur vers Mobile Money.
 * Traitée par ADMIN DKFarm. Seuil minimum : 5 000 FCFA.
 * R8 : siteId obligatoire.
 */
model RetraitPortefeuille {
  id               String                @id @default(cuid())
  portefeuilleId   String
  portefeuille     PortefeuilleIngenieur @relation(fields: [portefeuilleId], references: [id])
  montant          Decimal
  fournisseur      FournisseurPaiement
  phoneNumber      String
  statut           StatutPaiementAbo     @default(EN_ATTENTE)
  referenceExterne String?
  demandeLeBy      String
  demandeur        User                  @relation("RetraitDemandeur", fields: [demandeLeBy], references: [id])
  traitePar        String?
  traiteur         User?                 @relation("RetraitTraiteur", fields: [traitePar], references: [id])
  dateTraitement   DateTime?
  siteId           String
  site             Site                  @relation("RetraitsSite", fields: [siteId], references: [id])

  createdAt DateTime @default(now())

  @@index([portefeuilleId])
  @@index([siteId])
  @@index([statut])
}

// ──────────────────────────────────────────
// Modèle — IdempotencyRecord (Sprint 30.4)
// ──────────────────────────────────────────

/**
 * IdempotencyRecord — Cache des réponses de mutations pour la protection contre les replays.
 * Prevents duplicate mutations when an offline-queued request is retried after a network timeout.
 * R8 : siteId obligatoire.
 * R7 : expiresAt non-nullable (TTL 48h).
 */
model IdempotencyRecord {
  id         String   @id @default(uuid())
  key        String   @unique
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id])
  response   Json
  statusCode Int
  bodyHash   String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([siteId])
  @@index([expiresAt])
}

// ──────────────────────────────────────────
// Modèle — ModuleDefinition (ADR-021)
// ──────────────────────────────────────────

/**
 * ModuleDefinition — Registre des métadonnées des modules de la plateforme.
 * Approche hybride : l'enum SiteModule reste la clé forte (type-safety).
 * Ce modèle compléte l'enum avec les métadonnées (label, icône, visibilité, catégorie).
 * Note R8 : pas de siteId — registre global, exception documentée dans ADR-021 section 2.2.
 */
model ModuleDefinition {
  id          String   @id @default(cuid())
  /**
   * Clé unique — valeur de l'enum SiteModule. Source de vérité.
   */
  key         String   @unique
  /**
   * Label affiché dans l'UI
   */
  label       String
  /**
   * Description de ce que le module offre
   */
  description String?
  /**
   * Nom de l'icône Lucide (ex: "Fish", "Package")
   */
  iconName    String   @default("Package")
  /**
   * Ordre d'affichage dans les interfaces d'administration
   */
  sortOrder   Int      @default(0)
  /**
   * platform = réservé au site DKFarm, site = activable par sites clients
   */
  level       String   @default("site")
  /**
   * Modules requis pour activer celui-ci (dépendances, valeurs SiteModule)
   */
  dependsOn   String[] @default([])
  /**
   * Si false : masqué dans les interfaces sans le supprimer
   */
  isVisible   Boolean  @default(true)
  /**
   * Si false : ne peut plus être assigné à de nouveaux plans ou sites
   */
  isActive    Boolean  @default(true)
  /**
   * Catégorie fonctionnelle pour regroupement UI
   */
  category    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────
// Modèle — SiteAuditLog (ADR-021)
// ──────────────────────────────────────────

/**
 * SiteAuditLog — Journal d'audit des actions admin sur les sites.
 * Toute action admin (suspension, blocage, modification de modules) est loguée ici
 * dans la même transaction que la mutation principale (R4).
 * R8 : siteId obligatoire.
 */
model SiteAuditLog {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id])
  actorId   String
  actor     User     @relation("AuditLogActor", fields: [actorId], references: [id])
  /**
   * ex: SITE_SUSPENDED, MODULE_ADDED, ABONNEMENT_FORCED
   */
  action    String
  /**
   * Payload before/after pour l'action
   */
  details   Json?
  createdAt DateTime @default(now())

  @@index([siteId])
  @@index([actorId])
  @@index([createdAt])
}

// ──────────────────────────────────────────
// Modèle — EcartAssignationConstate (ADR-048, Sprint SU, story SU.2)
// ──────────────────────────────────────────

/**
 * Contexte (operation metier en cours) lors de la derniere detection d'un
 * ecart de conservation tolere sur un bac. R1 : valeurs en MAJUSCULES.
 */
enum ContexteDetectionEcart {
  ARRIVAGE
  TRANSFERT
  CALIBRAGE
  VENTE
  VENTE_ALEVINS
  BON_LIVRAISON
  INDETERMINE
}

/// EcartAssignationConstate — État courant (upserté) de l'écart de conservation
/// toléré sur un bac. Une ligne par bac en dérive (ou ayant déjà dérivé et
/// depuis résolu — conservée pour historique, cf. resoluLe).
/// R8 : siteId obligatoire.
model EcartAssignationConstate {
  id                  String                 @id @default(cuid())
  siteId              String
  site                Site                   @relation(fields: [siteId], references: [id])
  bacId               String                 @unique
  bac                 Bac                    @relation(fields: [bacId], references: [id])
  vagueId             String
  vague               Vague                  @relation(fields: [vagueId], references: [id])
  /// Écart signé constaté (actual - expected), identique à EcartBac.ecart du guard.
  ecart               Int
  /// Date de la toute première détection de cette dérive (jamais réécrite après création).
  premiereDetectionLe DateTime               @default(now())
  /// Date de la détection la plus récente (mise à jour à chaque upsert).
  derniereDetectionLe DateTime               @default(now()) @updatedAt
  /// Contexte (quelle opération métier était en cours) lors de la dernière détection.
  dernierContexte     ContexteDetectionEcart @default(INDETERMINE)
  /// Utilisateur ayant déclenché l'opération lors de la dernière détection.
  /// Nullable (R7) : verifyAssignationInvariant n'a pas toujours userId
  /// disponible (paramètre optionnel, cf. ADR-048 section 5) tant que les 9
  /// call sites ne sont pas tous migrés.
  dernierActorId      String?
  dernierActor        User?                  @relation("EcartAssignationActor", fields: [dernierActorId], references: [id])
  /// Date à laquelle l'écart est repassé à 0 (comptage correctif). Null tant que
  /// non résolu. La ligne n'est PAS supprimée à la résolution (historique conservé).
  resoluLe            DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([siteId, ecart])
  @@index([vagueId])
}

// ──────────────────────────────────────────
// Modèle — HistoriqueNutritionnel (Sprint FD.6)
// ──────────────────────────────────────────

/**
 * HistoriqueNutritionnel — Matérialisation des données nutritionnelles par vague et phase.
 * Table de cache analytique : évite de recalculer FCR, SGR, ADG, PER à chaque requête.
 * Les données peuvent être recalculées à tout moment depuis les relevés bruts.
 * R8 : siteId obligatoire.
 * @@unique([vagueId, phase]) : un seul enregistrement par vague et par phase.
 */
model HistoriqueNutritionnel {
  id      String       @id @default(cuid())
  vagueId String
  vague   Vague        @relation(fields: [vagueId], references: [id])
  phase   PhaseElevage

  // Métriques agrégées pour cette phase
  /**
   * /**
   * /**
   * /** FCR moyen sur la phase (kg aliment / kg gain)
   */
  fcrMoyen          Float?
  /**
   * SGR moyen sur la phase (% poids vif / jour)
   */
  sgrMoyen          Float?
  /**
   * ADG moyen sur la phase (g / jour) — Gain Quotidien Moyen
   */
  adgMoyen          Float?
  /**
   * PER moyen sur la phase (kg gain / kg protéines)
   */
  perMoyen          Float?
  /**
   * Quantité totale d'aliment distribué sur la phase (kg)
   */
  quantiteAlimentKg Float?
  /**
   * Poids moyen des poissons au début de la phase (g)
   */
  poidsMoyenDebut   Float?
  /**
   * Poids moyen des poissons à la fin de la phase (g)
   */
  poidsMoyenFin     Float?
  /**
   * Taux de survie sur la phase (%)
   */
  tauxSurvie        Float?
  /**
   * Durée effective de la phase en jours
   */
  dureeJours        Int?

  siteId    String
  site      Site     @relation(fields: [siteId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vagueId, phase])
  @@index([siteId])
}

// ──────────────────────────────────────────
// Modèle — GompertzVague (Sprint Gompertz)
// ──────────────────────────────────────────

/**
 * GompertzVague — Parametres du modele de croissance de Gompertz calibres sur les
 * releves biometriques d'une vague.
 * W(t) = W∞ × exp(−exp(−k × (t − ti)))
 * Un seul enregistrement par vague (@@unique vagueId).
 * Supprime en cascade avec la vague (onDelete: Cascade).
 * R8 : siteId obligatoire.
 */
model GompertzVague {
  id String @id @default(cuid())

  vagueId String @unique
  vague   Vague  @relation(fields: [vagueId], references: [id], onDelete: Cascade)

  /**
   * W∞ — Poids asymptotique (g)
   */
  wInfinity      Float
  /**
   * k — Constante de taux de croissance (1/jour)
   */
  k              Float
  /**
   * ti — Point d'inflexion (jours depuis le debut de la vague)
   */
  ti             Float
  /**
   * R² — Coefficient de determination (0-1)
   */
  r2             Float
  /**
   * RMSE — Erreur quadratique moyenne (g)
   */
  rmse           Float
  /**
   * Nombre de releves biometriques utilises pour le calibrage
   */
  biometrieCount Int

  /**
   * Niveau de confiance du calibrage.
   * INSUFFICIENT_DATA = < minPoints
   * LOW               = minPoints to minPoints+1
   * MEDIUM            = minPoints+2 to minPoints+4
   * HIGH              = >= minPoints+5 AND R² > 0.95
   */
  confidenceLevel String

  /**
   * The configElevage.gompertzWInfDefault value used during this calibration
   */
  configWInfUsed Float?

  /**
   * Frozen curve predictions: JSON map { jour: poids } for days ≤ lastObservationDay.
   * Once a prediction is recorded for a day, it never changes — even after recalibration.
   * Only predictions for days BEYOND lastObservationDay are regenerated from new params.
   */
  lockedCurve Json?

  /**
   * The latest biometry day (days since vague start) at the time of last calibration.
   * Predictions for days ≤ this value are frozen in lockedCurve.
   */
  lastObservationDay Int?

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  calculatedAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([siteId])
  @@index([vagueId])
}

// ──────────────────────────────────────────
// Modeles — Feature Flags (ADR-maintenance-mode)
// ──────────────────────────────────────────

/**
 * FeatureFlag — Flags de fonctionnalites de la plateforme.
 * Stockage global sans siteId : intentionnel, ces flags s'appliquent
 * a toute la plateforme, pas a un site en particulier (R8 exception documentee).
 * Flags predefined : MAINTENANCE_MODE (enabled: false par defaut)
 */
model FeatureFlag {
  /// Cle unique identifiant le flag (ex: "MAINTENANCE_MODE", "REGISTRATION_ENABLED")
  key           String   @id
  /// Flag active ou non
  enabled       Boolean  @default(false)
  /// Metadonnees optionnelles : raison, message d'affichage, date de fin, etc.
  value         Json?
  updatedAt     DateTime @updatedAt
  /// ID du super-admin qui a modifie en dernier (null si jamais modifie)
  updatedBy     String?
  updatedByUser User?    @relation(fields: [updatedBy], references: [id], onDelete: SetNull)
}

/**
 * PlatformAuditLog — Trace des actions platform-level effectuees par les super-admins.
 * Distinct de SiteAuditLog car ces actions n'appartiennent a aucun site.
 */
model PlatformAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  /// Ex: "FEATURE_FLAG_ENABLED", "FEATURE_FLAG_DISABLED"
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([createdAt])
}

// ──────────────────────────────────────────
// Modèles — ADR-020 : Subscription refactoring
// ──────────────────────────────────────────

/**
 * EssaiUtilise — Mémorise les essais gratuits consommés par utilisateur et par typePlan.
 * Exception R8 documentée : pas de siteId car l'essai est lié à l'utilisateur, pas au site.
 * @@unique([userId, typePlan]) garantit un seul essai par plan par utilisateur.
 */
model EssaiUtilise {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("EssaisUtilises", fields: [userId], references: [id])
  typePlan  TypePlan
  createdAt DateTime @default(now())

  @@unique([userId, typePlan])
  @@index([userId])
}

/**
 * AbonnementAudit — Journal d'audit des transitions d'abonnement.
 * Exception R8 documentée : pas de siteId car l'audit porte sur l'abonnement lui-même.
 * Sprint 52 : abonnement.siteId est désormais nullable (abonnement au niveau user).
 * onDelete: Restrict sur abonnement (pas de suppression silencieuse d'un abonnement audité).
 * Actions possibles : CREATION, UPGRADE, DOWNGRADE, RENOUVELLEMENT, ANNULATION,
 * ESSAI_DEBUT, ESSAI_CONVERSION, EXONERATION, CHANGEMENT_PERIODE, DOWNGRADE_ANNULE.
 */
model AbonnementAudit {
  id           String     @id @default(cuid())
  abonnementId String
  abonnement   Abonnement @relation(fields: [abonnementId], references: [id], onDelete: Restrict)
  action       String
  metadata     Json?
  userId       String
  user         User       @relation("AuditsAbonnement", fields: [userId], references: [id])
  createdAt    DateTime   @default(now())

  @@index([abonnementId])
  @@index([userId])
  @@index([createdAt])
}

// ──────────────────────────────────────────
// Modèles — Saved Filters
// ──────────────────────────────────────────

model SavedFilter {
  id        String   @id @default(cuid())
  name      String
  page      String // "besoins" | "commandes" | "releves"
  filters   Json
  userId    String
  user      User     @relation("SavedFilters", fields: [userId], references: [id], onDelete: Cascade)
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, siteId, page, name])
  @@index([userId, siteId, page])
}

// ──────────────────────────────────────────
// Modèles — Unités de production
// ──────────────────────────────────────────

/**
 * UniteProduction — Unité organisationnelle de production (REPRODUCTION ou GROSSISSEMENT).
 * Permet la séparation comptable des coûts entre la nurserie/reproduction et l'élevage grossissement.
 * R8 : siteId obligatoire.
 */
model UniteProduction {
  id          String              @id @default(cuid())
  code        String
  nom         String
  type        TypeUniteProduction
  description String?
  isActive    Boolean             @default(true)

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  vagues              Vague[]
  ventes              Vente[]
  depenses            Depense[]
  depensesRecurrentes DepenseRecurrente[]
  transfertsSortants  TransfertInterne[]  @relation("TransfertSource")
  transfertsEntrants  TransfertInterne[]  @relation("TransfertDestination")
  besoins             ListeBesoins[]
  releves             Releve[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, code])
  @@index([siteId])
  @@index([siteId, type])
}

/**
 * TransfertInterne — Transfert d'animaux (alevins ou poissons) d'une unité de production à une autre.
 * Utilisé notamment pour valoriser le transfert de lots d'alevins depuis la REPRODUCTION
 * vers le GROSSISSEMENT, avec un prix de cession interne.
 * R8 : siteId obligatoire.
 */
model TransfertInterne {
  id   String   @id @default(cuid())
  code String   @unique
  date DateTime @default(now())

  uniteSourceId String
  uniteSource   UniteProduction @relation("TransfertSource", fields: [uniteSourceId], references: [id])

  uniteDestinationId String
  uniteDestination   UniteProduction @relation("TransfertDestination", fields: [uniteDestinationId], references: [id])

  lotAlevinsId       String?
  lotAlevins         LotAlevins? @relation(fields: [lotAlevinsId], references: [id])
  vagueDestinationId String?
  vagueDestination   Vague?      @relation("TransfertEntrant", fields: [vagueDestinationId], references: [id])

  nombrePoissons Int
  poidsMoyenG    Float?
  prixUnitaire   Float
  /**
   * Base de calcul du prix : "PAR_POISSON" ou "PAR_KG"
   */
  prixBase       String @default("PAR_POISSON")
  montantTotal   Float

  description String?

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([uniteSourceId])
  @@index([uniteDestinationId])
  @@index([lotAlevinsId])
}

// ──────────────────────────────────────────
// Modèles — Transferts Pré-Grossissement (PG.2)
// ──────────────────────────────────────────

/**
 * Transfert — Opération de transfert de poissons d'une vague source vers une vague destination.
 * Peut contenir plusieurs groupes (TransfertGroupe) pour des catégories de taille différentes.
 * R8 : siteId obligatoire.
 */
model Transfert {
  id        String            @id @default(cuid())
  siteId    String
  site      Site              @relation(fields: [siteId], references: [id])
  date      DateTime          @default(now())
  notes     String?
  userId    String
  user      User              @relation("TransfertUser", fields: [userId], references: [id])
  groupes   TransfertGroupe[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([siteId])
  @@index([userId])
}

/**
 * TransfertGroupe — Un groupe de poissons transféré d'un bac/vague source vers un bac/vague destination.
 * Un Transfert peut avoir plusieurs groupes (ex: petits dans bac A, grands dans bac B).
 */
model TransfertGroupe {
  id          String    @id @default(cuid())
  transfertId String
  transfert   Transfert @relation(fields: [transfertId], references: [id], onDelete: Cascade)

  vagueSourceId String
  vagueSource   Vague   @relation("TransfertsSource", fields: [vagueSourceId], references: [id], onDelete: Restrict)
  bacSourceId   String?
  bacSource     Bac?    @relation("TransfertsBacSource", fields: [bacSourceId], references: [id])

  vagueDestId String
  vagueDest   Vague  @relation("TransfertsDestination", fields: [vagueDestId], references: [id], onDelete: Restrict)
  bacDestId   String
  bacDest     Bac    @relation("TransfertsBacDest", fields: [bacDestId], references: [id])

  nombrePoissons     Int
  poidsMoyenG        Float
  nombreMorts        Int   @default(0)
  snapshotAvantModif Json?

  modifications TransfertModification[]
  releves       Releve[]                @relation("TransfertReleves")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vagueSourceId])
  @@index([vagueDestId])
  @@index([transfertId])
}

/**
 * TransfertModification — Traçabilité des modifications apportées à un TransfertGroupe.
 * Cascade DELETE avec TransfertGroupe.
 * R8 : siteId obligatoire (pattern CalibrageModification).
 */
model TransfertModification {
  id                String          @id @default(cuid())
  transfertGroupeId String
  transfertGroupe   TransfertGroupe @relation(fields: [transfertGroupeId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("TransfertModificationUser", fields: [userId], references: [id])

  raison        String
  snapshotAvant Json
  snapshotApres Json

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  createdAt DateTime @default(now())

  @@index([transfertGroupeId])
  @@index([userId])
  @@index([siteId])
}

// ──────────────────────────────────────────
// Modèles — Arrivage (AR.1)
// ──────────────────────────────────────────

/**
 * Arrivage — enregistrement d'une entrée externe de poissons dans une vague PRE_GROSSISSEMENT.
 * Différent du Transfert (transfert sortant inter-vagues) : ici c'est une entrée depuis
 * l'extérieur (achat fournisseur, alevinage interne, etc.).
 * Suit le pattern Calibrage (snapshot avant/après, groupes par bac, modifications auditées).
 * R8 : siteId obligatoire.
 */
model Arrivage {
  id      String   @id @default(cuid())
  vagueId String
  vague   Vague    @relation("VagueArrivages", fields: [vagueId], references: [id], onDelete: Restrict)
  date    DateTime @default(now())
  /// Origine de l'arrivage — texte libre : "Achat Fournisseur X", "Alevinage interne", etc.
  origine String?
  notes   String?

  userId String
  user   User   @relation("ArrivageUser", fields: [userId], references: [id])
  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  groupes ArrivageGroupe[]

  /// Relevés auto-créés lors de l'arrivage (ARRIVAGE + BIOMETRIE par bac)
  releves Releve[] @relation("ArrivageReleves")

  /// Flag rapide : true si cet arrivage a été modifié après création
  modifie       Boolean                @default(false)
  modifications ArrivageModification[]

  /// Snapshot de l'état vague+bacs avant création de l'arrivage
  snapshotAvant      Json?
  /// Snapshot de l'état vague+bacs avant la dernière modification
  snapshotAvantModif Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vagueId])
  @@index([siteId])
  @@index([userId])
}

/**
 * ArrivageGroupe — un groupe de poissons arrivant dans un bac de destination.
 * Chaque groupe correspond à un bac destinataire avec un nombre de poissons et un poids moyen.
 * Cascade DELETE avec Arrivage.
 * Pas de siteId (cohérent avec CalibrageGroupe — le siteId est porté par Arrivage).
 */
model ArrivageGroupe {
  id               String   @id @default(cuid())
  arrivageId       String
  arrivage         Arrivage @relation(fields: [arrivageId], references: [id], onDelete: Cascade)
  destinationBacId String
  destinationBac   Bac      @relation("ArrivageGroupeBac", fields: [destinationBacId], references: [id])
  nombrePoissons   Int
  /// Poids moyen des poissons en grammes
  poidsMoyen       Float
  createdAt        DateTime @default(now())

  @@index([arrivageId])
  @@index([destinationBacId])
}

/**
 * ArrivageModification — trace d'une modification d'arrivage avec raison d'audit.
 * Stocke les snapshots avant/après complets (JSON) pour permettre l'annulation.
 * Cascade DELETE avec Arrivage.
 * R8 : siteId obligatoire (pattern CalibrageModification).
 */
model ArrivageModification {
  id            String   @id @default(cuid())
  arrivageId    String
  arrivage      Arrivage @relation(fields: [arrivageId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation("ArrivageModificationUser", fields: [userId], references: [id])
  raison        String
  snapshotAvant Json
  snapshotApres Json
  siteId        String
  site          Site     @relation(fields: [siteId], references: [id])
  createdAt     DateTime @default(now())

  @@index([arrivageId])
  @@index([userId])
  @@index([siteId])
}

// ──────────────────────────────────────────
// Modèles — Prévisions (Sprint PR1, ADR-053)
// ──────────────────────────────────────────

enum StatutScenarioPrevision {
  BROUILLON // en cours de paramétrage, éditable sans restriction
  ACTIF // publié, sert de référence pour le rapprochement — édition restreinte (ADR-053 §4.3)
  ARCHIVE // remplacé par un scénario plus récent, conservé en lecture seule
}

enum StatutVaguePrevue {
  PLANIFIEE // pas encore de vague réelle liée
  EN_COURS // vagueId renseigné, vague réelle non clôturée
  REALISEE // vagueId renseigné, vague réelle clôturée
  NON_REALISEE // le plan est passé, aucune vague réelle n'a jamais été liée
  ANNULEE // scission ou abandon explicite — jamais une suppression physique
}

enum TypePostePrevision {
  LOGISTIQUE // ex. transport des alevins, transport aliments — entre dans base_repartition
  CHARGE_EXPLOITATION // ex. électricité, salaires — entre dans base_repartition
}

enum CategorieJournalPrevu {
  OPERATIONNEL // dépense récurrente/ponctuelle d'exploitation — entre dans base_repartition SI non affectée
  INVESTISSEMENT // hors base_repartition, jamais quote-partée (ADR-053 décision 6)
}

enum TypeApportCapital {
  CAPITAL // apport propre
  CREDIT // emprunt encaissé — un crédit reçu est un apport de trésorerie, son remboursement
  // futur est une sortie (ADR-053 point ouvert 9.3), jamais un investissement
}

enum SourceRapprochement {
  DEPENSE_CATEGORIE // CategorieDepense réelle
  PRODUIT_CATEGORIE // CategorieProduit réelle
  VENTE // Vente réelle (agrégat mensuel)
  MOUVEMENT_STOCK // MouvementStock réel (agrégat mensuel)
}

enum CibleRapprochement {
  POSTE_PREVISION // vers PostePrevision
  ALIMENT_PREVISION // vers AlimentPrevision
  VENTE_PREVUE // vers le revenu prévu (ParametresPrevision.prixVenteKgFCFA)
  NON_RAPPROCHE // bac explicite — jamais un silence (ADR-053 section 5)
}

model ScenarioPrevision {
  id             String                  @id @default(cuid())
  code           String // ex. "PLAN-2026-08" — numéroté, PAS unique global
  nom            String
  description    String? // nullable : libre
  dureeCycleMois Int                     @default(3)
  dateDebutPlan  DateTime // premier mois du plan (mois 0 de tous les calculs relatifs)
  statut         StatutScenarioPrevision @default(BROUILLON)
  userId         String // créateur — NOT NULL, jamais anonyme
  user           User                    @relation(fields: [userId], references: [id])
  siteId         String
  site           Site                    @relation(fields: [siteId], references: [id])

  parametres        ParametresPrevision?
  paliersRemise     PalierRemise[]
  aliments          AlimentPrevision[]
  vaguesPrevues     VaguePrevue[]
  postes            PostePrevision[]
  chargesMensuelles ChargeMensuellePrevue[]
  journal           JournalDepensePrevue[]
  apports           ApportCapital[]
  clotures          ClotureMois[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteId, code])
  @@index([siteId])
  @@index([siteId, statut])
}

model ParametresPrevision {
  id         String            @id @default(cuid())
  scenarioId String            @unique
  scenario   ScenarioPrevision @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  effectifAlevinsParVague   Int // nombre d'alevins stockés par vague planifiée
  margeSecuriteAlevinsPct   Decimal // absorbe la mortalité — ADR-053 décision 4
  poidsMoyenInitialG        Decimal
  poidsObjectifG            Decimal
  prixAlevinUnitaireFCFA    Decimal
  /**
   * Prix de vente au kg prévisionnel — comble le gap dashboard.ts:218
   * (ADR-053 section 8.1). NOT NULL : jamais de calcul de revenu
   * prévisionnel silencieusement basé sur un null.
   */
  prixVenteKgFCFA           Decimal
  nombreBacsSimultanesCible Int // capacité de rotation ciblée, purement paramétrique —
  // ne référence AUCUN Bac réel (ADR-053 section 4, note découplage)
  frequenceStockageMois     Decimal // espacement entre deux stockages successifs (peut être < 1 mois)

  /**
   * Paramètres de transport (ex-GAP DE MODELE signalé par l'en-tête de
   * src/lib/previsions/logistique.ts, jeu d'or "Paramètres!B25:B30").
   * NOT NULL avec @default reprenant les valeurs du jeu d'or : ces
   * paramètres entrent dans base_repartition via logistique.sousTotal ;
   * les rendre nullables imposerait un COALESCE implicite chez l'appelant
   * ou bloquerait le calcul (review-sprint-PR1.md, réserve 3).
   * NB : le moteur (logistique.ts) reste à signature explicite — ces
   * champs sont la SOURCE des valeurs passées en argument par l'appelant,
   * jamais lus directement par le moteur (ADR-053 décision 1).
   */
  capaciteTransportAlimentsSacs Int     @default(60) // Paramètres!B25
  coutTransportAlimentsFCFA     Decimal @default(15000) // Paramètres!B26 — CHECK >= 0 (migration)
  capaciteTransportPoissonsKg   Int     @default(1500) // Paramètres!B27
  coutTransportPoissonsFCFA     Decimal @default(25000) // Paramètres!B28 — CHECK >= 0 (migration)
  capaciteTransportAlevinsNb    Int     @default(20000) // Paramètres!B29
  coutTransportAlevinsFCFA      Decimal @default(30000) // Paramètres!B30 — CHECK >= 0 (migration)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PalierRemise {
  id                String            @id @default(cuid())
  scenarioId        String
  scenario          ScenarioPrevision @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  seuilSacs         Decimal // quantité de sacs à partir de laquelle le palier s'applique
  pourcentageRemise Decimal
  ordre             Int // ordre d'évaluation explicite — jamais déduit d'un tri implicite sur seuilSacs
  siteId            String
  site              Site              @relation(fields: [siteId], references: [id])

  @@index([scenarioId])
  @@index([siteId])
}

model AlimentPrevision {
  id            String            @id @default(cuid())
  scenarioId    String
  scenario      ScenarioPrevision @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  /**
   * Rapprochement uniquement — jamais lu par le moteur de calcul (ADR-053 décision 1).
   * Nullable : un aliment prévisionnel peut ne correspondre à aucun produit
   * réel du catalogue (ex. produit pas encore créé, ou scénario prospectif).
   */
  produitId     String?
  produit       Produit?          @relation(fields: [produitId], references: [id], onDelete: SetNull)
  libelle       String // copié depuis Produit.nom à la création, puis libre
  tailleGranule TailleGranule? // copié depuis Produit.tailleGranule à la création
  poidsSacKg    Decimal // copié depuis Produit.contenance à la création
  prixSacFCFA   Decimal // copié depuis Produit.prixUnitaire à la création
  sacsParTonne  Decimal // dérivable de poidsSacKg, mais stocké et gelé (ADR-053 décision 1 :
  // aucun recalcul depuis une formule qui lirait le catalogue)
  ordre         Int // ordre d'affichage / d'application dans le cycle
  siteId        String
  site          Site              @relation(fields: [siteId], references: [id])

  repartitions  RepartitionMoisAliment[]
  vaguesPrevues AlimentParVaguePrevue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scenarioId])
  @@index([siteId])
  @@index([produitId])
}

model RepartitionMoisAliment {
  id                 String           @id @default(cuid())
  alimentPrevisionId String
  alimentPrevision   AlimentPrevision @relation(fields: [alimentPrevisionId], references: [id], onDelete: Cascade)
  moisCycle          Int // 1..scenario.dureeCycleMois — jamais un index 0-based, pour lisibilité UI
  pourcentage        Decimal // somme des pourcentages sur toutes les lignes d'un AlimentPrevision = 100,
  // vérifiée par l'application à l'enregistrement (ADR-053 section 3.5)
  siteId             String
  site               Site             @relation(fields: [siteId], references: [id])

  @@unique([alimentPrevisionId, moisCycle])
  @@index([siteId])
}

model VaguePrevue {
  id                   String            @id @default(cuid())
  scenarioId           String
  scenario             ScenarioPrevision @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  code                 String // ex. "V7", "V7a" — numéroté au sein du scénario
  dateStockagePrevue   DateTime
  effectifAlevinsPrevu Int // copié depuis ParametresPrevision à la création, éditable ensuite
  // (une VaguePrevue individuelle peut diverger du paramètre par défaut)
  poidsMoyenInitialG   Decimal
  dureeCycleMoisFigee  Int // copie gelée de scenario.dureeCycleMois au moment de la création —
  // un changement ultérieur de la durée de cycle du scénario n'affecte
  // JAMAIS une VaguePrevue déjà créée (ADR-053 décision 1, §4.1 des exigences)
  statut               StatutVaguePrevue @default(PLANIFIEE)
  /**
   * Auto-relation — matérialise une scission (ADR-053 décision 2). Null pour une
   * VaguePrevue d'origine, renseigné pour V7a/V7b issues d'une scission de V7.
   */
  vaguePrevueParentId  String?
  vaguePrevueParent    VaguePrevue?      @relation("ScissionVaguePrevue", fields: [vaguePrevueParentId], references: [id], onDelete: SetNull)
  enfantsScission      VaguePrevue[]     @relation("ScissionVaguePrevue")
  siteId               String
  site                 Site              @relation(fields: [siteId], references: [id])

  vague           Vague? // relation inverse du champ Vague.vaguePrevueId
  alimentsParMois AlimentParVaguePrevue[]
  journal         JournalDepensePrevue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scenarioId, code])
  @@index([siteId])
  @@index([scenarioId, statut])
}

model AlimentParVaguePrevue {
  id                 String           @id @default(cuid())
  vaguePrevueId      String
  vaguePrevue        VaguePrevue      @relation(fields: [vaguePrevueId], references: [id], onDelete: Cascade)
  alimentPrevisionId String
  alimentPrevision   AlimentPrevision @relation(fields: [alimentPrevisionId], references: [id], onDelete: Restrict)
  moisCycle          Int // 1..dureeCycleMoisFigee de la VaguePrevue parente
  sacsCalcules       Int // sortie pure du moteur (ADR-053 section 4) — jamais éditée directement — nombre de sacs, par construction un entier (ceil)
  /**
   * Surcharge manuelle. Null = utiliser sacsCalcules. Non-null = l'utilisateur
   * a ajusté le besoin réel constaté sur le terrain sans passer par un
   * recalcul complet du scénario. Tous les calculs downstream (coût, budget,
   * trésorerie) utilisent COALESCE(sacsSaisis, sacsCalcules) — jamais
   * sacsCalcules seul une fois qu'une surcharge existe.
   */
  sacsSaisis         Int?
  quantiteKgCalculee Decimal
  coutCalculeFCFA    Decimal // après application des PalierRemise
  siteId             String
  site               Site             @relation(fields: [siteId], references: [id])

  @@unique([vaguePrevueId, alimentPrevisionId, moisCycle])
  @@index([siteId])
  @@index([vaguePrevueId])
}

model PostePrevision {
  id                    String             @id @default(cuid())
  scenarioId            String
  scenario              ScenarioPrevision  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  libelle               String // référentiel paramétrable — PAS un enum codé en dur
  // (le classeur Excel a fait évoluer ses lignes de dépenses
  // d'une version à l'autre ; coder les postes en enum aurait
  // exigé une migration de schéma à chaque ligne ajoutée)
  type                  TypePostePrevision // LOGISTIQUE | CHARGE_EXPLOITATION
  /**
   * Inclus dans base_repartition (ADR-053 décision 6) — vrai pour la quasi-totalité
   * des postes de logistique/exploitation. Un poste peut être exclu
   * explicitement (ex. un poste exceptionnel qu'on veut suivre sans qu'il
   * dilue la quote-part de toutes les vagues).
   */
  inclusBaseRepartition Boolean            @default(true)
  ordre                 Int
  siteId                String
  site                  Site               @relation(fields: [siteId], references: [id])

  chargesMensuelles ChargeMensuellePrevue[]

  @@unique([scenarioId, libelle])
  @@index([siteId])
}

model ChargeMensuellePrevue {
  id          String            @id @default(cuid())
  scenarioId  String
  scenario    ScenarioPrevision @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  posteId     String
  poste       PostePrevision    @relation(fields: [posteId], references: [id], onDelete: Cascade)
  moisAbsolu  Int // 0-based depuis scenario.dateDebutPlan (mois 0 = dateDebutPlan)
  montantFCFA Decimal
  siteId      String
  site        Site              @relation(fields: [siteId], references: [id])

  @@unique([posteId, moisAbsolu])
  @@index([siteId])
  @@index([scenarioId, moisAbsolu])
}

model JournalDepensePrevue {
  id            String                @id @default(cuid())
  scenarioId    String
  scenario      ScenarioPrevision     @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  date          DateTime
  libelle       String
  categorie     CategorieJournalPrevu // OPERATIONNEL | INVESTISSEMENT
  montantFCFA   Decimal
  /**
   * Affectation nominative à une vague planifiée précise. Null = dépense
   * générale du plan (entre dans base_repartition si categorie=OPERATIONNEL
   * et poste associé inclusBaseRepartition=true — ADR-053 décision 6). Non-null =
   * déjà affectée à cette vague, EXCLUE de base_repartition pour éviter le
   * double comptage (ADR-053 décision 6).
   */
  vaguePrevueId String?
  vaguePrevue   VaguePrevue?          @relation(fields: [vaguePrevueId], references: [id], onDelete: SetNull)
  siteId        String
  site          Site                  @relation(fields: [siteId], references: [id])

  @@index([siteId])
  @@index([scenarioId, date])
  @@index([vaguePrevueId])
}

model ApportCapital {
  id          String            @id @default(cuid())
  scenarioId  String
  scenario    ScenarioPrevision @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  date        DateTime
  libelle     String
  montantFCFA Decimal
  type        TypeApportCapital // CAPITAL | CREDIT — un crédit encaissé est un apport de
  // trésorerie, jamais un investissement (ADR-053 §7)
  siteId      String
  site        Site              @relation(fields: [siteId], references: [id])

  @@index([siteId])
  @@index([scenarioId, date])
}

model MappingRapprochement {
  id         String              @id @default(cuid())
  siteId     String // rapprochement scopé au site, PAS au scénario — un mapping
  // sert potentiellement plusieurs scénarios successifs du même site
  site       Site                @relation(fields: [siteId], references: [id])
  version    Int // incrémenté à chaque changement de mapping — jamais un UPDATE
  // en place d'une ligne active, pour préserver l'auditabilité d'un
  // rapprochement passé même si le mapping change ensuite
  sourceType SourceRapprochement
  sourceCle  String // valeur littérale de l'enum réel (ex. "ALIMENT" pour CategorieDepense)
  cibleType  CibleRapprochement
  cibleId    String? // nullable : NON_RAPPROCHE n'a pas de cible (ADR-053 section 5)
  actif      Boolean             @default(true)
  createdAt  DateTime            @default(now())

  @@unique([siteId, version, sourceType, sourceCle])
  @@index([siteId, actif])
}

model ClotureMois {
  id            String            @id @default(cuid())
  scenarioId    String
  scenario      ScenarioPrevision @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  moisAbsolu    Int // même référentiel que ChargeMensuellePrevue.moisAbsolu
  clotureeParId String
  clotureePar   User              @relation(fields: [clotureeParId], references: [id])
  dateCloture   DateTime          @default(now())
  siteId        String
  site          Site              @relation(fields: [siteId], references: [id])

  @@unique([scenarioId, moisAbsolu])
  @@index([siteId])
}
